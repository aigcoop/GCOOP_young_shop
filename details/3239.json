ra .contents {\r\n        width: 80%;\r\n        margin: 0 auto;\r\n        background-color: #fff;\r\n        padding: 5% 0;\r\n    }\r\n\r\n    .cotton,\r\n    .cupra {\r\n        display: inline-block;\r\n        padding-bottom: 10%;\r\n    }\r\n\r\n    .cotton img,\r\n    .cupra img {\r\n        width: 80%;\r\n    }\r\n\r\n    .cotton {\r\n        position: relative;\r\n    }\r\n\r\n    .cotton .p01 {\r\n        position: absolute;\r\n        top: 2%;\r\n        left: 10%;\r\n        font-size: 18px;\r\n    }\r\n\r\n    .cotton .p02 {\r\n        position: absolute;\r\n        top: 20%;\r\n        left: 67%;\r\n        font-size: 18px;\r\n    }\r\n\r\n    .cotton .p03 {\r\n        position: absolute;\r\n        top: 46%;\r\n        left: 70%;\r\n        font-size: 18px;\r\n    }\r\n\r\n    .cotton .tit,\r\n    .cupra .tit {\r\n        font-size: 25px;\r\n        font-weight: 500;\r\n        color: #000;\r\n        border-bottom: 1px solid #000;\r\n        display: inline-block;\r\n    }\r\n\r\n    .Cupra_compare {\r\n        width: 90%;\r\n        height: auto;\r\n        margin: 0 auto;\r\n        border: 1px solid #fff;\r\n        background-color: #fff;\r\n        margin-top: 10%;\r\n    }\r\n\r\n    .Cupra_compare .rounded {\r\n        width: 300px;\r\n        background-color: #333;\r\n        padding: 0.5% 6%;\r\n        border-radius: 2em;\r\n        -moz-border-radius: 2em;\r\n        -webkit-border-radius: 2em;\r\n        text-align: center;\r\n        margin: 0 auto;\r\n        color: #fff;\r\n        font-size: 25px;\r\n        font-weight: 500;\r\n        line-height: 35px;\r\n        margin-top: -3%;\r\n    }\r\n\r\n    .Cupra_compare .contents {\r\n        width: 85%;\r\n        margin: 0 auto;\r\n        background-color: #fff;\r\n        padding: 10% 0;\r\n    }\r\n\r\n    .compare_cupra {\r\n        display: inline-block;\r\n        width: 32%;\r\n        padding: 3% 0;\r\n    }\r\n\r\n    .compare_cupra img {\r\n        width: 90%;\r\n    }\r\n\