img {\r\n\twidth: 16%;\r\n\tmargin: 0 auto;\r\n}\r\n.dermatest .img img {\r\n\twidth: 100%;\r\n}\r\n.dermatest h3 {\r\n\tfont-size: 43px;\r\n\tfont-weight: 400;\r\n\tline-height: 55px;\r\n\tmargin-top: 1%;\r\n\tcolor: #000;\r\n}\r\n.dermatest p {\r\n\tmargin-top: 2%;\r\n}\r\n.dermatest p span {\r\n\tfont-weight: 600;\r\n}\r\n\r\n\r\n/**브랜드스토리**/\r\n.brand_story .point_tit {\r\n\tcolor: #000;\r\n\tfont-size: 3em;\r\n\tfont-weight: 700;\r\n\ttext-align: center;\r\n\ttext-transform: uppercase;\r\n\tmargin-top: 1%;\r\n}\r\n.brand_story .point_tit span { font-weight: 400;}\r\n.brand_story {\r\n\twidth: 96%;\r\n\theight: auto;\r\n\tborder: 1px solid #b1b1b1;\r\n\tmargin: 0 auto;\r\n\tmargin-top: 8%;\r\n\t/*margin-bottom: 8%;*/\r\n\tpadding-bottom: 2%;\r\n}\r\n.brand_story .rounded {\r\n  width: 200px;\r\n  background-color: #403025;\r\n  border:2px solid #000;\r\n  padding:0.1em 1em;\r\n  border-radius: 3em;\r\n  -moz-border-radius: 3em;\r\n  -webkit-border-radius: 3em;\r\n  color: #fff;\r\n  margin: 0 auto;\r\n  font-size: 1.2em;\r\n  line-height: 1.2em;\r\n  margin-top: -1.7%;\r\n  text-align: center;\r\n }\r\n\r\n.brand_story .content {\r\n\twidth: 93%;\r\n\tmargin: 0 auto;\r\n\ttext-align: left;\r\n\tmargin-top: 3%;\r\n\tmargin-bottom: 3%;\r\n}\r\n.brand_story .content .img, .brand_story .content .txt {\r\n\tdisplay: inline-block;\r\n\tvertical-align: top;\r\n}\r\n.brand_story .content .img {\r\n\twidth: 50%;\r\n}\r\n.brand_story .content .img img { width: 100%;}\r\n.brand_story .content .txt { \r\n\ttext-align: left;\r\n\twidth: 45%;\r\n\tmargin-left: 3%;\r\n\tword-break: keep-all;\r\n}\r\n.brand_story .brand_logo { width: 50%;}\r\n.brand_story .brand_logo img {width: 100%;}\r\n.brand_story .content .bd {\r\n\twidth: 8%;\r\n\theight: 2px;\r\n\tbackground-color: #666;\r\n\tmargin-top: 5%;\r\n}\r\n.brand_story .content .txt p {\r\n\tcolor: #333;\r\n\tfont-size: 22px;\r\n\tfont-weight: 400;\r\n\tmargin-top: 5%;\r\n}\r\n.brand_story .content .txt p span {\r\n\tfont-weigh