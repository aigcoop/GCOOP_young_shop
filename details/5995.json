.Special_Point {display:grid;grid-template-columns:50% 1fr;justify-content:center;align-items:center;}\r\n            .Special_Point .flex_box li {display:flex;align-items:center;padding:1.3em 0 1.2em;border-bottom:1px dotted #7a6f62;}\r\n            .Special_Point .flex_box li:last-of-type {border-bottom:none;}\r\n            .Special_Point .flex_box li p:nth-of-type(2) {margin-left:1.5em;}\r\n\r\n            /* 한국인의 식습관에 최적화된 효소 밸런스 */\r\n            .Enzyme_Graph > div {position:absolute;width:34.1667%;height:34.1667%;}\r\n            .Enzyme_Graph .percent {font-size:0.5em;}\r\n            .Enzyme_Graph > div:nth-child(1) {top:5.4762%;left:14.8809%;}\r\n            .Enzyme_Graph > div:nth-child(2) {top:37.619%;left:0.238%;}\r\n            .Enzyme_Graph > div:nth-child(3) {bottom:19.1666%;right:3.0952%;}\r\n            \r\n            /* POINT 01 : 자연 재료 발효 그대로의 효소 배합 */\r\n            .QuotationMarks {width:4.3vw !important;max-width:52px !important;}\r\n\r\n            /* POINT 03: 소화를 돕는 자연 유래 원료 배합 */\r\n            .IngredientBlend {width:20vw !important;max-width:240px !important;}\r\n\r\n            /* 영양정보 */\r\n            .ThirtyFold {transform:translateY(-50%);}\r\n            .DotLine {border-bottom:1px dotted #c7a889;}\r\n\r\n            /* 브랜드 스토리 */\r\n            .Brand_Grid {display:grid;grid-template-columns:40% 58%;justify-content:space-between;align-items:start;border:#ccc solid 1px;text-align:left;}\r\n            .Brand_Grid .logo_img {max-width:25% !important;margin-top:1em;}\r\n\r\n            @media all and (max-width:1200px) {\r\n                .Product_DetailWrap {padding-bottom:6vw;letter-spacing:-0.05vw;}\r\n                .Product_DetailWrap .mt_10 {margin-top:0.8333vw;}\r\n                .Product_DetailWrap .mt_20 {margin-top:1.6667vw;}\r\n                .Product_DetailWrap .mt_30 {margin-top:2.5vw;}\r\n                .Product_DetailWrap .mt_40 {margin-top:3.3333vw;}\r\n                .Product_DetailWrap .mt_50 {margin-top:4.1667vw;}\r\n                .Product_DetailWrap .mt_60 {margin-top:5vw;}\r\n                .Product_DetailWrap .mt_70 {margin-top:5.83337vw;}\r\n                .Product_DetailWrap .mt_80 {margin-top:6.6667vw;}\r\n                .Product_DetailWrap .mt_90 {margin-top:7.5vw;}\r\n                .Product_DetailWrap .mt_100 {margin-top:8.3333vw;}\r\n                .Product_DetailWrap .mt_110 {margin-top:9.1667vw;}\r\n                .Product_DetailWrap .mt_120 {margin-top:10vw;}\r\n                .Product_DetailWrap .mt_130 {margin-top:10.8333vw;}\r\n                .Product_DetailWrap .mt_140 {margin-top:11.6667vw;}\r\n                .Product_DetailWrap .mt_150 {margin-top:12.5vw;}\r\n                .Product_DetailWrap .plr_60 {padding:0 5vw;}\r\n                .Product_DetailWrap .pd_40 {padding:3.3333vw;}\r\n                .Product_DetailWrap .pt_20 {padding-top:1.6667vw;}\r\n                .Product_DetailWrap .pt_30 {padding-top:2.5vw;}\r\n                .Product_DetailWrap .pt_40 {padding-top:3.3333vw;}\r\n                .Product_DetailWrap .pt_50 {padding-top:4.1667vw;}\r\n                .Product_DetailWrap .pt_60 {padding-top:5vw;}\r\n                .Product_DetailWrap .pt_70 {padding-top:5.83337vw;}\r\n                .Product_DetailWrap .pt_80 {padding-top:6.6667vw;}\r\n                .Product_DetailWrap .pt_90 {padding-top:7.5vw;}\r\n                .Product_DetailWrap .pt_100 {padding-top:8.3333vw;}\r\n                .Product_DetailWrap .pt_110 {padding-top:9.1667vw;}\r\n                .Product_DetailWrap .pt_120 {padding-top:10vw;}\r\n                .Product_DetailWrap .pt_130 {padding-top:10.8333vw;}\r\n                .Product_DetailWrap .pt_140 {padding-top:11.6667vw;}\r\n                .Product_DetailWrap .pt_150 {padding-top:12.5vw;}\r\n                .Product_DetailWrap .pb_20 {padding-bottom:1.6667vw;}\r\n                .Product_DetailWrap .pb_30 {padding-bottom:2.5vw;}\r\n                .Product_DetailWrap .pb_40 {padding-bottom:3.3333vw;}\r\n                .Product_DetailWrap .pb_50 {padding-bottom:4.1667vw;}\r\n                .Product_DetailWrap .pb_60 {padding-bottom:5vw;}\r\n                .Product_DetailWrap .pb_70 {padding-bottom:5.83337vw;}\r\n                .Product_DetailWrap .pb_80 {padding-bottom:6.6667vw;}\r\n                .Product_DetailWrap .pb_90 {padding-bottom:7.5vw;}\r\n                .Product_DetailWrap .pb_100 {padding-bottom:8.3333vw;}\r\n                .Product_DetailWrap .pb_110 {padding-bottom:9.1667vw;}\r\n                .Product_DetailWrap .pb_120 {padding-bottom:10vw;}\r\n                .Product_DetailWrap .pb_130 {padding-bottom:10.8333vw;}\r\n                .Product_DetailWrap .pb_140 {padding-bottom:11.6667vw;}\r\n                .Product_DetailWrap .pb_150 {padding-bottom:12.5vw;}\r\n            }\r\n\r\n            @media all and (max-width:1080px) {\r\n                .Product_DetailWrap {font-size:10px;}\r\n                .Product_DetailWrap .p0 {font-size:1.1667vw;}/*14px*/\r\n                .Product_DetailWrap .p1 {font-size:1.5vw;}/*18px*/\r\n                .Product_DetailWrap .p2 {font-size:2vw;}/*24px*/\r\n                .Product_DetailWrap .p3 {font-size:2.6667vw;}/*32px*/\r\n                .Product_DetailWrap .p4 {font-size:4vw;}/*48px*/\r\n                .Product_DetailWrap .p5 {font-size:5vw;}/*60px*/\r\n                .Product_DetailWrap .p6 {font-size:6vw;}/*72px*/\r\n                .Product_DetailWrap .ybr {display:block;}\r\n                .Product_DetailWrap .nbr {display:none;}\r\n                .Product_DetailWrap .grid_bulletList img {margin-top:0.2em;}\r\n                .KeyImg .keyimg_grid .line {padding-top:2vw;margin-bottom:2vw;}\r\n            }\r\n\r\n            @media all and (max-width:920px) {\r\n                .Product_DetailWrap {font-size:9px;}\r\n                .Product_DetailWrap .w80 {width:90%;margin-left:5%;}\r\n            }\r\n\r\n            @media all and (max-width:820px) {\r\n                .Product_DetailWrap {font-size:8px;}\r\n            }\r\n\r\n            @media all and (max-width:720px) {\r\n                .Product_DetailWrap {font-size:7px;}\r\n            }\r\n\r\n            @media all and (max-width:620px) {\r\n                .Product_DetailWrap {font-size:6px;}\r\n            }\r\n\r\n            @media all and (max-width:510px) {\r\n                .Brand_Grid {grid-template-columns:1fr;row-gap:4.1667vw;text-align:center;}\r\n                .Brand_Grid .logo_img {margin-top:0 !important;}\r\n            }\r\n\r\n            @media all and (max-width:520px) {\r\n                .Product_DetailWrap {font-size:5px;}\r\n            }\r\n\r\n            @media all and (max-width:420px) {\r\n                .Product_DetailWrap {font-size:4px;}\r\n            }\r\n\r\n            @media all and (max-width:320px) {\r\n                .Product_DetailWrap {font-size:3px;}\r\n            }\r\n</style>\n<div class=\"Product_DetailWrap\">\n<section class=\"KeyImg pos_r\">\n<div class=\"key_TextBox ta_l lh_12\"><img class=\"the_elixir_logo\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_logo.png\"/>\n<p class=\"p3 fw_300 mt_50\">라이프 스타일에 따라 달라지는<br/>\r\n나만의 묘약 레시피</p>\n<p class=\"p6 wMax pos_r color_DarkChocolateBrown mt_10\">지쿱 디엘릭서 <span class=\"fw_700\">브라운 효소</span><img class=\"theelixir_brown\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_enzyme.png\"/></p>\n<p class=\"p3 color_DarkChocolateBrown mt_30\">나만의 <span class=\"fw_500\">식전 효소 루틴</span><br/>\r\n매일 식사 전 한 포, 식후까지 편안하게</p>\n<p class=\"p2 fw_300 mt_20\">오늘의 가벼운 시작,<br/>\r\n디엘릭서 브라운 효소와 함께 하세요</p>\n</div>\n<img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_keyimg.jpg\"/></section>\n\n<section class=\"w80 mt_150\">\n<p class=\"p4 color_DarkChocolateBrown fw_700\">디엘릭서 <span class=\"color_SandBeige\">브라운 효소</span>의 특별함</p>\n<div class=\"Special_Point ta_l mt_50\"><img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_01.jpg\"/>\n<ul class=\"flex_box\">\n<li>\n<p class=\"p5 font_NMb lh_10 color_GoldenOat\">01</p>\n<p class=\"p2 fw_500 color_DarkChocolateBrown\">역가 수치 무려 <span class=\"color_SandBeige\">100만 UNIT</span></p>\n</li>\n<li>\n<p class=\"p5 font_NMb lh_10 color_GoldenOat\">02</p>\n<p class=\"p2 fw_500 color_DarkChocolateBrown\">자연 재료 발효 효소 배합</p>\n</li>\n<li>\n<p class=\"p5 font_NMb lh_10 color_GoldenOat\">03</p>\n<p class=\"p2 fw_500 color_DarkChocolateBrown\">식후 밸런스 케어 포뮬러</p>\n</li>\n<li>\n<p class=\"p5 font_NMb lh_10 color_GoldenOat\">04</p>\n<p class=\"p2 fw_500 color_DarkChocolateBrown\">고급스럽고 깊은 맛</p>\n</li>\n</ul>\n</div>\n</section>\n\n<section class=\"mt_150 bg_IvoryWhite pt_110 pb_110 bdr_10\">\n<p class=\"p4 fw_500 lh_12 color_DarkChocolateBrown\">한국인의 식습관에 최적화된<br/>\n<span class=\"color_SandBeige\">효소 밸런스</span></p>\n<div class=\"Enzyme_Graph w70 color_white lh_12 pos_r mt_50\">\n<div class=\"flex_c_auto\">\n<p class=\"p3 fw_500\">지방</p>\n<p class=\"p4 fw_700\">19.7<span class=\"percent\">%</span></p>\n</div>\n<div class=\"flex_c_auto\">\n<p class=\"p3 fw_500\">단백질</p>\n<p class=\"p4 fw_700\">14.7<span class=\"percent\">%</span></p>\n</div>\n<div class=\"flex_c_auto\">\n<p class=\"p3 fw_500\">탄수화물</p>\n<p class=\"p4 fw_700\">65.6<span class=\"percent\">%</span></p>\n</div>\n<img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_02.jpg\"/></div>\n<p class=\"p3 fw_500 color_DarkChocolateBrown mt_20\">[한국인의 영양소별 1일 섭취량]</p>\n<p class=\"p1\">출처 : 2012 국민건강 영양통계, 질병관리본부</p>\n<div class=\"w90 bg_white pt_80 pb_80 plr_60 mt_100 bdr_10\">\n<p class=\"p4 fw_500 lh_12 color_DarkChocolateBrown\">탄수화물 섭취가 현저히 높은<br/>\r\n한국인들의 식습관</p>\n<ul class=\"grid_3step mt_50\">\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_03_01.jpg\"/>\n<p class=\"p3 fw_500 color_DarkChocolateBrown mt_20\">입</p>\n<p class=\"p2 mt_02em\"><span class=\"fw_500 color_SandBeige\">α -아밀라아제</span><br/>\n<span>: 탄수화물 분해</span></p>\n</li>\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_03_02.jpg\"/>\n<p class=\"p3 fw_500 color_DarkChocolateBrown mt_20\">위</p>\n<p class=\"p2 mt_02em\"><span class=\"fw_500 color_SandBeige\">프로테아제(펩신)</span><br/>\n<span>: 단백질 분해</span></p>\n</li>\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_03_03.jpg\"/>\n<p class=\"p3 fw_500 color_DarkChocolateBrown mt_20\">소장</p>\n<p class=\"p2 mt_02em\"><span class=\"fw_500 color_SandBeige\">α-아밀라아제, 리파아제,<br/>\r\n\t프로테아제(펩신)</span><br/>\n<span>: 탄수화물, 단백질, 지방 분해</span></p>\n</li>\n</ul>\n</div>\n<p class=\"p3 color_DarkChocolateBrown mt_110\">하루 한 포로 충분하도록 탄수화물이 많은 식단 특성을 고려해<br/>\r\nα-아밀라아제를 중심으로 <span class=\"fw_500 color_SandBeige\">단백질 분해효소 프로테아제와<br/>\r\n지방 분해효소 리파아제를 균형 있게 배합</span> 했습니다.</p>\n<div class=\"w90 mt_60\"><img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_04.jpg\"/></div>\n<p class=\"p4 fw_500 lh_12 color_DarkChocolateBrown mt_20\">“단 한 포로도 충분한 역가<br/>\r\n식사 후 부담없이, 소화는 더 부드럽게”</p>\n</section>\n\n<section class=\"w80 mt_150\">\n<div class=\"PointNum font_NMeb p2 color_DarkChocolateBrown\">Point 01</div>\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_12 mt_30\">자연 재료 발효 그대로의 효소 배합</p>\n<p class=\"p3 mt_30 color_SandBeige\">디엘릭서 브라운 효소<br/>\r\n1포 당 효소 활성도(역가 수치)</p>\n<img class=\"QuotationMarks mt_50\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_quotationmarks_bottom.jpg\"/>\n<p class=\"p3 color_DarkChocolateBrown mt_20\">역가수치는 효소의 함량과 활성도를 나타내는 수치입니다.<br/>\n<span class=\"fw_500\">효소 식품은 효소 활성도가 얼마나 높은지,<br/>\r\n역가 안정성이 보장되는지를 확인하는 것이 중요합니다.</span></p>\n<img class=\"QuotationMarks mt_20\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_quotationmarks_top.jpg\"/>\n<ul class=\"grid_2step mt_50\">\n<li class=\"bg_IvoryWhite pt_50 pb_50 bdr_10\">\n<p class=\"p1\">탄수화물 분해효소</p>\n<p class=\"p3 color_DarkChocolateBrown fw_500\">α-아밀라아제</p>\n<img class=\"mt_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_05_01.jpg\"/>\n<p class=\"p2 color_DarkChocolateBrown mt_10\">1포당</p>\n<p class=\"p3 color_SandBeige fw_700 lh_12\">1,000,000unit</p>\n</li>\n<li class=\"bg_IvoryWhite pt_50 pb_50 bdr_10\">\n<p class=\"p1\">단백질 분해효소</p>\n<p class=\"p3 color_DarkChocolateBrown fw_500\">프로테아제</p>\n<img class=\"mt_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_05_02.jpg\"/>\n<p class=\"p2 color_DarkChocolateBrown mt_10\">1포당</p>\n<p class=\"p3 color_SandBeige fw_700 lh_12\">5,000unit</p>\n</li>\n</ul>\n</section>\n\n<section class=\"w90 mt_150 bdr_10 pos_r\">\n<div class=\"w90 pos_a pt_110\">\n<div class=\"PointNum font_NMeb p2 color_DarkChocolateBrown\">Point 02</div>\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_12 mt_30\">곡물 과채 유래 발효 효소</p>\n<p class=\"p3 mt_30\">디엘릭서 브라운 효소는 정제효소를 첨가하지 않은,<br/>\r\n자연 발효 그대로의 곡류, 과채 발효 효소로<br/>\r\n완성 되었습니다.</p>\n</div>\n<img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_06.jpg\"/></section>\n\n<section class=\"w80 mt_150\">\n<div class=\"PointNum font_NMeb p2 color_DarkChocolateBrown\">Point 03</div>\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_12 mt_30\">소화를 돕는 자연 유래 원료 배합</p>\n<img class=\"IngredientBlend mt_60\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_checkpoint.jpg\"/>\n<p class=\"p2 mt_10\">자연에서 찾은 소화의 지혜<br/>\n<span class=\"fw_500 color_SandBeige\">예로부터 소화와 기력 회복에 사용되어 온 진피, 매실, 감초</span>를<br/>\r\n정성스럽게 배합했습니다.</p>\n<ul class=\"grid_3step mt_50\">\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_07_01.jpg\"/>\n<p class=\"p2 fw_500 color_DarkChocolateBrown mt_10\">진피</p>\n</li>\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_07_02.jpg\"/>\n<p class=\"p2 fw_500 color_DarkChocolateBrown mt_10\">매실</p>\n</li>\n<li><img class=\"bdr_10\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_07_03.jpg\"/>\n<p class=\"p2 fw_500 color_DarkChocolateBrown mt_10\">감초</p>\n</li>\n</ul>\n</section>\n\n<section class=\"bg_IvoryWhite mt_150 bdr_t_10\">\n<div class=\"PointNum font_NMeb p2 color_DarkChocolateBrown mt_120\">Point 04</div>\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_12 mt_30\">식후에도 가볍게, 밸런스 UP</p>\n<p class=\"p3 mt_30\">여주, 돼지감자, 바나바잎 세 가지 식물 유래 원료의 조화가<br/>\r\n식사 후에도 편안한 밸런스를 유지 하도록 돕습니다.</p>\n<div class=\"w80 bdr_10 mt_60\"><img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_08.jpg\"/></div>\n</section>\n\n<section class=\"pos_r bdr_b_10\">\n<div class=\"w90 pos_a pt_150\">\n<div class=\"PointNum font_NMeb p2 color_DarkChocolateBrown\">Point 05</div>\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_12 mt_30\">고급스럽고 깊은 맛</p>\n<p class=\"p3 mt_30\">정제된 단맛이 아닌, 자연이 오랜 시간 빚은 깊은 맛.<br/>\r\n곡물과 과일이 천천히 발효되며 만들어낸<br/>\r\n은은한 풍미와 부드러운 단맛</p>\n</div>\n<img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_09.jpg\"/></section>\n\n<section class=\"mt_150\">\n<p class=\"p4 color_DarkChocolateBrown fw_700 lh_10\">영양정보</p>\n<p class=\"p1 mt_10\">* 해당 내용은 제품의 정보와는 상관 없는 건강 관련 정보 입니다.</p>\n<div class=\"bg_IvoryWhite pt_80 pb_80 mt_50 bdr_10\">\n<p class=\"p3 color_DarkChocolateBrown\">효소는 <span class=\"fw_500\">체내 대사 활동에 작용</span>하는<br/>\r\n단백질 촉매입니다.</p>\n<p class=\"p1 mt_10\">출처 : &lt;효소의 건강학&gt; 신진대사에 관여하는 ‘생명의 불꽃＇월간중앙(2017)</p>\n<ul class=\"w80 grid_2step mt_50\">\n<li class=\"bg_white pt_60 pb_60 bdr_10\">\n<div class=\"Round_Title bg_WarmTaupeBrown pt_30 pb_30\">\n<p class=\"p2 color_white fw_500 lh_10\">체내 효소가 부족한 경우</p>\n</div>\n<img class=\"mt_50\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_10_01.jpg\"/>\n<p class=\"p2 fw_500 mt_30\">효소작용 저하</p>\n<p class=\"p1 lh_12 mt_10\">섭취한 영양성분의 분해가<br/>\r\n\t완전하게 이루어지지 않음</p>\n</li>\n<li class=\"bg_white pt_60 pb_60 bdr_10\">\n<div class=\"Round_Title bg_SandBeige pt_30 pb_30\">\n<p class=\"p2 color_white fw_500 lh_10\">섭취한 효소가 충분한 경우</p>\n</div>\n<img class=\"mt_50\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_10_02.jpg\"/>\n<p class=\"p2 fw_500 color_SandBeige mt_30\">효소작용 원활</p>\n<p class=\"p1 lh_12 mt_10\">섭취한 영양성분의 분해가<br/>\r\n\t완전하게 이루어짐</p>\n</li>\n</ul>\n<div class=\"DotLine w80 mt_120\"> </div>\n<p class=\"p3 color_DarkChocolateBrown mt_100\"><span class=\"fw_500\">알고 계셨나요?</span><br/>\r\n연령에 따라 감소하는 체내 효소</p>\n<div class=\"w80 bg_white plr_60 pt_60 pb_70 bdr_10 mt_50\">\n<div class=\"pos_r\">\n<ul class=\"ThirtyFold grid_4step w100 pos_a\">\n<li> </li>\n<li> </li>\n<li> </li>\n<li>\n<p class=\"CircleBox p1 bg_SandBeige color_white fw_500 lh_12\">30배<br/>\r\n\t감소</p>\n</li>\n</ul>\n<img decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoop.me/storage/global_image/the_elixir_brown/the_elixir_brown_img_11.jpg\"/></div>\n