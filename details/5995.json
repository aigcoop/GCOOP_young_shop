 .Product_DetailWrap .pb_60 {padding-bottom:60px;}\r\n            .Product_DetailWrap .pb_70 {padding-bottom:70px;}\r\n            .Product_DetailWrap .pb_80 {padding-bottom:80px;}\r\n            .Product_DetailWrap .pb_90 {padding-bottom:90px;}\r\n            .Product_DetailWrap .pb_100 {padding-bottom:100px;}\r\n            .Product_DetailWrap .pb_110 {padding-bottom:110px;}\r\n            .Product_DetailWrap .pb_120 {padding-bottom:120px;}\r\n            .Product_DetailWrap .pb_130 {padding-bottom:130px;}\r\n            .Product_DetailWrap .pb_140 {padding-bottom:140px;}\r\n            .Product_DetailWrap .pb_150 {padding-bottom:150px;}\r\n            \r\n            /* GRID · FLEX 스타일 */\r\n            /* .grid_demo {display:grid;grid-template-columns:29% 6.5% 29% 6.5% 29%;justify-content:space-between;} */\r\n            .Product_DetailWrap .grid_2step {display:grid;grid-template-columns:repeat(2, 49%);justify-content:space-between;row-gap:1.6em;}\r\n            .Product_DetailWrap .grid_3step {display:grid;grid-template-columns:repeat(3, 32%);justify-content:space-between;}\r\n            .Product_DetailWrap .grid_4step {display:grid;grid-template-columns:repeat(4, 24%);justify-content:space-between;}\r\n            .Product_DetailWrap .grid_textList {display:grid;grid-template-columns:2.4167em auto;justify-content:center;align-items:start;gap:1.25em;}\r\n            .Product_DetailWrap .grid_bulletList {display:grid;grid-template-columns:2.5em auto;justify-content:center;align-items:start;gap:1.25em 1em;}\r\n            .Product_DetailWrap .flex_c {display:flex;align-items:center;}\r\n            .Product_DetailWrap .flex_auto {flex:auto;}\r\n            .Product_DetailWrap .flex_c_auto {flex:auto;flex-direction:column;display:flex;justify-content:center;align-items:center;}\r\n\r\n            /* TABLE STYLE */\r\n            .Product_DetailWrap table{width:100%;padding:0;border:0;border-spacing:0px;border-collapse:collapse;font-size:unset;}\r\n            .Product_DetailWrap .Table_Style1 th {background-color:#f3f3f3;border:1px solid #ccc;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #ccc;color:#121212;font-weight:600;}\r\n            .Product_DetailWrap .Table_Style1 td {border:1px solid #ccc;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n            .Product_DetailWrap .Table_Style1 tr td:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;color:#724848;}\r\n            .Product_DetailWrap .Table_Style1 tr:last-child td:nth-child(3) {border-bottom:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style1 tr th:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;border-top:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style2 th {background-color:#f9f2f2;border:1px solid #e0d0c3;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #e1e1e1;color:#724848;}\r\n            .Product_DetailWrap .Table_Style2 td {border:1px solid #e0d0c3;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n\r\n            /* 기타 스타일 */\r\n            .Product_DetailWrap .w70 {width:70%;margin-left:15%;}\r\n            .Product_DetailWrap .w80 {width:80%;margin-left:10%;}\r\n            .Product_DetailWrap .w90 {width:90%;margin-left:5%;}\r\n            .Product_DetailWrap .w100 {width:100%;}\r\n            .Product_DetailWrap .mgAuto {margin-left:auto;margin-right:auto;}\r\n            .Product_DetailWrap .pos_r {position:relative;}\r\n            .Product_DetailWrap .pos_a {position:absolute;}\r\n            .Product_DetailWrap .wMax {width:max-content;}\r\n            .Product_DetailWrap .wFit {width:fit-content;}\r\n            .Product_DetailWrap .opac80 {opacity:0.8;}\r\n            .Product_DetailWrap .bdr_10 {border-radius:0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_10v {border-radius:0.8333em;}\r\n            .Product_DetailWrap .bdr_t_10 {border-radius:0.8333em 0.8333em 0 0;overflow:hidden;}\r\n           