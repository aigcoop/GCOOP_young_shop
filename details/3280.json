{"html":"<div class=\"product_detail\">\n<div align=\"center\" class=\"pdt_detail_img\">\n<img alt=\"제품 상세 공지(탑) - 온라인 가품 유통 주의 안내\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoopm.com/shop/storage/shop_image/Ww8yREXDVplPHT9vZS1WKnZe1DiprZ143KbzqknD.jpg\"/>\n</div>\n<div align=\"center\" class=\"pdt_detail_img\" style=\"padding:10px;\"><br/><br/><br/></div>\n</div>\n<div class=\"pdt_detail_img\">\n<style type=\"text/css\">.product_detail_page h1, h2, h3, h4, h5, h6, ul, ol, li, dl, dt, dd, p, form, fieldset, input, table, tr, th, td, button, textarea {margin:0;padding:0;}\r\n.product_detail_page {\r\n\twidth: 100%;\r\n\tmax-width:1200px; \r\n\tmargin: 0 auto; \r\n\tpadding: 0; \r\n\tfont-family: 'Noto Sans KR', sans-serif;\r\n\ttext-align: center;\r\n\tfont-weight: 400;\r\n\tletter-spacing: -0.05em;\r\n\tword-break: keep-all;\r\n}\r\n.product_detail_page p {\r\n\tcolor: #666;\r\n\tfont-weight: 400;\r\n\tfont-size: 22px;\r\n}\r\n.product_detail_page p span {\r\n\tcolor: #333;\r\n\tfont-weight: 600;\r\n}\r\n.product_detail_page p.sub_p {\r\n\twidth: 80%;\r\n\tmargin: 0 auto;\r\n\tmargin-bottom: 3%;\r\n}\r\n.product_detail_page h3 {\r\n\tfont-weight: 600;\r\n\tfont-size: 50px;\r\n\ttext-align: center;\r\n\tcolor: #000;\r\n\tmargin: 0 auto;\r\n\twidth: 90%;\r\n\tmargin-top: 1%;\r\n\tmargin-bottom: 2%;\r\n}\r\n.product_detail_page h3 span {\r\n\tfont-weight: 300;\r\n\tcolor: #000;\r\n}\r\n.product_detail_page h5 {\r\n\tfont-weight: 600;\r\n\tfont-size: 20px;\r\n\ttext-transform: uppercase;\r\n\tcolor: #ed919c;\r\n\tdisplay: inline;\r\n\t/*background-color: #002472;\r\n\tpadding: 0 0.7%;*/\r\n\tborder-bottom: 1px solid #ed919c;\r\n}\r\n.product_detail_page img {\r\n\tmax-width: 100%;\r\n}\r\n.product_detail_page h4 {\r\n\tfont-size: 40px;\r\n\tfont-weight: 600;\r\n\tcolor: #000;\r\n\twidth: 90%;\r\n\tmargin: 0 auto;\r\n\tmargin-bottom: 1%;\r\n}\r\n.product_detail_page h4 span {\r\n\tfont-weight: 400;\r\n}\r\n\r\n\r\n\r\n\r\n/**키이미지**/\r\n.product_detail_page 