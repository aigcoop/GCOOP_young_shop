padding:0 4%; /*margin:7% 0;*/ position:relative; width: 23%;}\r\n.product_detail_page .key_box .features .box:after{content:''; width:1px; height:36px; position:absolute; top:50%; right:0;\r\n\tmargin-top:-18px; background-color: #fff;}\r\n.product_detail_page .key_box .features .box:last-child:after {content:none;}\r\n.product_detail_page .key_box .features .box:last-child {margin-right: 0;}\r\n.product_detail_page .key_box .features p {color: #fff; font-weight: 400; line-height:1.3;}\r\n\r\n\r\n\r\n\r\n.product_detail_page .section { width: 100%; padding-top: 7%;}\r\n.product_detail_page p.sub_p02 {font-size: 28px; color: #333; width: 95%; margin: 0 auto; margin-top: 3%; margin-bottom: 3%;}\r\n\r\n.product_detail_page .left_bar {\r\n\tdisplay: inline-block;\r\n\twidth: 35%;\r\n\theight: 1px;\r\n\tbackground-color: #333333;\r\n\tmargin-right: 3%;\r\n}\r\n.product_detail_page .right_bar {\r\n\tdisplay: inline-block;\r\n\twidth: 35%;\r\n\theight: 1px;\r\n\tbackground-color: #333333;\r\n\tmargin-left: 3%;\r\n}\r\n.product_detail_page .tit_round {margin-bottom: 4%;}\r\n.product_detail_page .tit_round .round {\r\n\tdisplay: inline-block;\r\n\twidth: 100px;\r\n\theight: 100px;\r\n\tborder:2px solid #333333;\r\n\tborder-radius: 75px;\r\n\t-moz-border-radius: 75px;\r\n\t-webkit-border-radius: 75px;\r\n\tmargin: 0 auto;\r\n\ttext-align: center;\r\n\ttext-transform: uppercase;\r\n }\r\n.product_detail_page .tit_round .round p {\r\n\tfont-size: 15px;\r\n\tcolor: #333333;\r\n\tline-height: 28px;\r\n\tmargin-top: 15%;\r\n}\r\n.product_detail_page .tit_round .round p span {\r\n\tfont-size: 32px;\r\n\tfont-weight: 700;\r\n\tcolor: #333333;\r\n}\r\n.product_detail_page .left_bar, .product_detail_page .right_bar, .tit_round .round {\r\n\tvertical-align: middle;\r\n}\r\n\r\n\r\n.product_detail_page .main_h3 {margin: 5% 0;}\r\n.point01 {}\r\n.point01 .content {width: 90%; margin: 0 auto;}\r\n.point01 .content .group {margin-bottom: 3%;}\r\n.point01 .content .group:last-child {margin-bottom: 0;}\r\n.point01 .content .group .img {display: inline-block; vertical-align: middle; width: 35%;}\r\n.point01 .content .group .txt_box {display: inline-block; vertical-align: middle; width: 40%; margin-left: 5%;}\r\n.point01 .content .group:nth-child(2) .txt_box {margin-left: 0; margin-right: 5%;}\r\n.point01 .content .group .txt_box .tit {color: #333; font-weight: 600; font-size: 28px; margin-bottom: 2%;}\r\n.point01 .content .group .txt_box .txt {color: #333; font-weight: 400; font-size: 22px;}\r\n\r\n\r\n.point02 {}\r\n.point02 .content {width: 85%; margin: 0 auto; padding-top: 5%;}\r\n.point02 .content .group {}\r\n.point02 .content .group .box {display: inline-block; vertical-align: top; width: 30%; margin-right: 3%;}\r\n.point02 .content .group .box:last-child {margin-right: 0;}\r\n.point02 .content .group .box .img {width: 70%; margin: 0 auto;}\r\n.point02 .content .group .box .txt_box {}\r\n.point02 .content .group .box .txt_box .num {font-weight: 600; font-size: 30px; color: #8cc2e8;}\r\n.point02 .content .group .box .txt_box .tit {font-weight: 600; font-size: 26px; color: #333; margin-top: 10%;}\r\n.point02 .content .group .box .txt_box .txt {font-weight: 400; font-size: 20px; color: #333; margin-top: 5%;}\r\n\r\n\r\n.point04\r\n.point04 .content {width: 90%; margin: 0 auto;}\r\n.point04 .content .group {\r\n\twidth: 80%;\r\n\tmargin: 0 auto;\r\n\tbackground-color: #fff;\r\n\tborder-radius: 2em;\r\n\tmargin-top: 3%;\r\n}\r\n.point04 .content .group:nth-child(1) {margin-top: 5%;}\r\n.point04 .content .group .box {\r\n\tdisplay: inline-block;\r\n\twidth: 20%;\r\n\tvertical-align: top;\r\n\t-ms-word-break: break-all;\r\n\tword-break: break-all;\r\n}\r\n.point04 .content .group .box .round {\r\n\twidth: 120px;\r\n\theight: 120px;\r\n\tbackground-color: #70001a;\r\n\tborder: 0;\r\n\tborder-radius: 50px;\r\n\t-moz-border-radius: 125px;\r\n\t-webkit-border-radius: 125px;\r\n\tmargin: 0 auto;\r\n\ttext-align: center;\r\n\tfont-size: 45px;\r\n\tcolor: #fff;\r\n\tline-height: 2.6;\r\n}\r\n.point04 .content .group .box p.sub_p02 {\r\n\tfont-weight: 400;\r\n\tcolor: #333;\r\n\tmargin-top: 3%;\r\n}\r\n\r\n\r\n.point05 {}\r\n.point05 table {width: 85%; margin: 0 auto; border-collapse: collapse; font-size: 19px; color: #000;}\r\n.point05 table th {width: 25.3%; border: 1px solid #8c9eab;\r\n\tpadding: 1% 0; font-weight: 600; background-color: #8cc2e8;}\r\n.point05 table th:nth-child(1) {width: 7%;}\r\n.point05 table th:last-child {width: 17%; border-right: none;}\r\n.point05 table td {border: 1px solid #8c9eab; padding: 0.6%;}\r\n.point05 table .bg_sky {background-color: #eaf6fd;}\r\n\r\n\r\n.point06 .content {width: 85%; margin: 0 auto; margin-top: 5%;}\r\n.point06 .content .box {margin-top: 2%;}\r\n.point06 .content .box .img {display: inline-block; vertical-align: middle; width: 26%;}\r\n.point06 .content .box .txt_box {display: inline-block; vertical-align: middle; width: 45%; margin-left: 5%; text-align: left;}\r\n.point06 .content .box .txt_box .tit {font-size: 30px; color: #333; font-weight: 600; display: inline-block; \r\n\tbackground: linear-gradient(to top, #badaf1 50%, transparent 50%);}\r\n.point06 .content .box .txt_box .txt {font-size: 24px; color: #333; margin-top: 3%;}\r\n\r\n.point06 .content .box .imgR {display: inline-block; vertical-align: middle; width: 26%;}\r\n.point06 .content .box .txt_boxR {display: inline-block; vertical-align: middle; width: 45%; margin-right: 5%; text-align: right;}\r\n.point06 .content .box .txt_boxR .tit {font-size: 30px; color: #333; font-weight: 600; display: inline-block; \r\n\tbackground: linear-gradient(to top, #badaf1 50%, transparent 50%);}\r\n.point06 .content .box .txt_boxR .txt {font-size: 24px; color: #333; margin-top: 3%;}\r\n.point06 .content .box .txt_boxR .txt span {font-size: 20px;}\r\n\r\n\r\n.point07 .content {width: 85%; margin: 0 auto; margin-top: 5%;}\r\n.point07 .content .product_img {width: 50%; margin: 0 auto;}\r\n.point07 .content .effect_box {width: 