: left;\r\n                }\r\n\r\n                .Product_detail_page .ta_r {\r\n                    text-align: right;\r\n                }\r\n\r\n                .Product_detail_page .point_line {\r\n                    display: inline;\r\n                    padding: 0 0.5%;\r\n                    background: linear-gradient(to top, #ffebee 50%, transparent 50%);\r\n                }\r\n\r\n                .Product_detail_page .clearfix::after {\r\n                    content: '';\r\n                    display: block;\r\n                    clear: both;\r\n                }\r\n\r\n                /* main_content */\r\n                .main_content {\r\n                    background: #b8eab9;\r\n                    position: relative;\r\n                }\r\n\r\n                .main_content .bg_leaf {\r\n                    content: \"\";\r\n                    position: absolute;\r\n                    top: 0;\r\n                    left: 50%;\r\n                    transform: translateX(-50%);\r\n                }\r\n\r\n                .main_content .main_txt {\r\n                    width: 90%;\r\n                    margin: 0 auto;\r\n                    background: #fff;\r\n                    box-shadow: 4px 0px 3px #b2e2b3, -4px 0px 3px #b2e2b3;\r\n                }\r\n\r\n                /* point01 */\r\n                .point01 {\r\n                    background: #f0faf0;\r\n                    padding-bottom: 5vh;\r\n                }\r\n\r\n                .point01 h5 {\r\n                    padding-top: 20vh;\r\n                }\r\n\r\n                .point01 img {\r\n                    width: 88%;\r\n                }\r\n\r\n                /**/\r\n                .point02 {\r\n                    position: relative;\r\n                }\r\n\r\n                .point02:before {\r\n                    content: \"\";\r\n                    width: 0;\r\n                    height: 0;\r\n                    border-top: 6vh solid #f0faf0;\r\n                    border-bottom: 6vh solid transparent;\r\n                    border-left: 6vh solid transparent;\r\n                    border-right: 6vh solid transparent;\r\n                    position: absolute;\r\n                    top: 0;\r\n                    left: 50%;\r\n                    transform: translateX(-50%);\r\n                }\r\n\r\n                .point02 h5 {\r\n                    padding-top: 10vh;\r\n                }\r\n\r\n                /**/\r\n                .ingredient {\r\n                    background: #f0faf0;\r\n                    position: relative;\r\n                    padding-bottom: 10vh;\r\n                }\r\n\r\n                .ingredient:before {\r\n                    content: \"\";\r\n                    width: 0;\r\n                    height: 0;\r\n                    border-top: 6vh solid #fff;\r\n                    border-bottom: 6vh solid transparent;\r\n                    border-left: 6vh solid transparent;\r\n                    border-right: 6vh solid transparent;\r\n                    position: absolute;\r\n                    top: 0;\r\n                    left: 50%;\r\n                    transform: translateX(-50%);\r\n                }\r\n\r\n                .ingredient h5 {\r\n                    padding-top: 10vh;\r\n                }\r\n\r\n                .ingredient .content .tit_label {\r\n                    background: #30754f;\r\n                    padding: 2vh 0;\r\n                    margin-bottom: 3vh;\r\n                }\r\n\r\n                .ingredient .content .tit_label h3 {\r\n                    padding: 0;\r\n                }\r\n\r\n                .ingredient .content h3 {\r\n                    font-size: 40px;\r\n                }\r\n\r\n                .ingredient .content img {\r\n                    width: 80%;\r\n                }\r\n\r\n                /**/\r\n                .hara_hills_img {\r\n                    position: relative;\r\n                }\r\n\r\n                .hara_hills_img p {\r\n                    position: absolute;\r\n                    top: 56%;\r\n                    left: 68%;\r\n                    letter-spacing: 0.5em;\r\n                    font-family: 'GyeonggiBatang';\r\n                    color: #fff;\r\n                    font-size: 20px;\r\n                }\r\n\r\n                /**/\r\n                .selective_purchasing {\r\n                    background: #f0faf0;\r\n                    padding-bottom: 8vh;\r\n                }\r\n\r\n                .selective_purchasing h5 {\r\n                    padding-top: 10vh;\r\n                    font-weight: 400;\r\n                }\r\n\r\n                .selective_purchasing .content p {\r\n                    font-size: 34px;\r\n                }\r\n\r\n                .selective_purchasing .content p span.large {\r\n                    font-weight: 500;\r\n                    font-size: 1.3em;\r\n                }\r\n\r\n                /**/\r\n                .precautions {\r\n                    padding: 8vh 0;\r\n                }\r\n\r\n                .precautions .content {\r\n                    display: flex;\r\n                    width: 85%;\r\n                    align-items: center;\r\n                }\r\n\r\n                .precautions .content .img {\r\n                    flex: 0 0 40%;\r\n                }\r\n\r\n                .precautions .content .txt {\r\n                    flex: 0 0 51%;\r\n                    margin-left: 9%;\r\n                    text-align: left;\r\n                }\r\n\r\n                .precautions .content .txt img {\r\n                    width: 75%;\r\n                }\r\n\r\n                .precautions .content .txt p:nth-of-type(1) {\r\n                    font-size: 30px;\r\n                    margin: 2vh 0\r\n                }\r\n\r\n                .precautions .content .txt p:nth-of-type(2) {\r\n                    font-size: 25px;\r\n                }\r\n\r\n                /**/\r\n                .how_to_test {\r\n                    padding: 8vh 0;\r\n                    background: #f0faf0;\r\n                }\r\n\r\n                .how_to_test .content {\r\n                    width: 90%;\r\n                    display: flex;\r\n                    flex-wrap: wrap;\r\n                    justify-content: center;\r\n                }\r\n\r\n                .how_to_test .content .Box {\r\n                    flex: 0 0 45%;\r\n                }\r\n\r\n                .how_to_test .content .Box .img {\r\n                    background: #fff;\r\n                    border: 4px solid #221815;\r\n                    border-radius: 1em 1em 0 0;\r\n                    position: relative;\r\n                }\r\n\r\n                .how_to_test .content .Box .img img {\r\n                    display: block;\r\n                    padding-top: 3vh;\r\n                }\r\n\r\n                .how_to_test .content .Box .img p {\r\n                    position: absolute;\r\n                    top: 5%;\r\n                    left: 8%;\r\n                }\r\n\r\n                .how_to_test .content .Box .img p span {\r\n                    font-size: 2em;\r\n                }\r\n\r\n                .how_to_test .content .Box .txt {\r\n                    background: #221815;\r\n                    border-radius: 0 0 1em 1em;\r\n                    display: flex;\r\n                    padding: 2vh 0;\r\n                }\r\n\r\n                .how_to_test .content .Box .txt p {\r\n                    color: #fff;\r\n                }\r\n\r\n                .how_to_test .content .Box .txt p:nth-of-type(1) {\r\n                    flex: 0 0 28%;\r\n                    font-family: 'GyeonggiBatang';\r\n                    font-weight: 600;\r\n                    font-size: 55px;\r\n                    display: flex;\r\n                    justify-content: center;\r\n                    align-items: center;\r\n                }\r\n\r\n                .how_to_test .content .Box .txt p:nth-of-type(2) {\r\n                    text-align: left;\r\n                    flex: 0 0 70%;\r\n                    padding-right: 1vh;\r\n                    font-size: 20px;\r\n                }\r\n\r\n                .how_to_test .content .Box:nth-child(2n) {\r\n                    margin-left: 5%;\r\n                }\r\n\r\n                .how_to_test .content .Box:nth-child(n+3) {\r\n                    margin-top: 5vh;\r\n                }\r\n\r\n                /**/\r\n                .precautions02 {\r\n                    padding: 8vh 0;\r\n                }\r\n\r\n                .precautions02 p:nth-of-type(1) {\r\n                    font-size: 32px;\r\n                    margin-bottom: 3vh;\r\n                }\r\n\r\n                /**/\r\n                .certification {\r\n                    padding: 8vh 0;\r\n                }\r\n\r\n                .certification .box_h5 {\r\n                    position: relative;\r\n                }\r\n\r\n                .certification .box_h5 h5 {\r\n                    position: absolute;\r\n                    top: 50%;\r\n                    left: 50%;\r\n                    transform: translate(-50%, -50%);\r\n                    width: 100%;\r\n                }\r\n\r\n                .certification .content {\r\n                    width: 90%;\r\n                }\r\n\r\n                .certification .content .Box {\r\n                    position: relative;\r\n                    padding: 3vh 4vh;\r\n                    display: flex;\r\n                    align-items: center;\r\n                }\r\n\r\n                .certification .content .Box:after {\r\n                    content: \"\";\r\n                    width: 100%;\r\n                    height: 1px;\r\n                    background: #b7b4b3;\r\n                    position: absolute;\r\n                    bottom: 0;\r\n                    left: 0;\r\n                }\r\n\r\n                .certification .content .Box:last-child:after {\r\n                    content: none;\r\n                }\r\n\r\n                .certification .content .Box .img {\r\n                    flex: 0 0 27%;\r\n                }\r\n\r\n                .certification .content .Box .txt {\r\n                    flex: 0 0 68%;\r\n                    text-align: left;\r\n                    margin-left: 5%;\r\n                }\r\n\r\n                .certification .content .Box .txt p:nth-of-type(1) {\r\n                    font-weight: 600;\r\n                    font-size: 30px;\r\n                }\r\n\r\n                .certification .content .Box .txt p:nth-of-type(2) {\r\n                    display: inline;\r\n                    color: #333;\r\n                    font-size: 20px;\r\n                    border-bottom: 1px solid #333;\r\n                }\r\n\r\n                .certification .content .Box .txt p:nth-of-type(3) {\r\n                    color: #333;\r\n                    font-size: 16px;\r\n                    margin-top: 0.5vh;\r\n                }\r\n</style>\n<div class=\"Product_detail_page\">\n<div class=\"key_img\">\n<div class=\"key_box\">\n<div class=\"key_tit\">\n<h1>하라힐즈 오가닉 퓨어 카시아</h1>\n</div>\n</div>\n<img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_New/CASSIA/key.jpg\"/></div>\n<div class=\"main_content\"><img alt=\"\" class=\"bg_leaf\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img01.png\"/>\n<div class=\"main_txt\">\n<div class=\"point01\">\n<h5>FEATURE 01</h5>\n<p class=\"sub_p\"> </p>\n<img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_New/img02_2026.05.13.png\"/></div>\n<div class=\"point02\">\n<h5>FEATURE 02</h5>\n<h3><span class=\"gr semi_bold\">순수한 단일 원료</span>만을 사용하였습니다.</h3>\n<div class=\"contnet\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Orgnic_Pure_Cassia/img01.png\"/></div>\n</div>\n<div class=\"ingredient\">\n<h5 class=\"regular\">원료</h5>\n<div class=\"content\">\n<div class=\"tit_label\">\n<h3 class=\"wh semi_bold\">카시아 | Cassia</h3>\n</div>\n<h3><span class=\"bold\">Cassia Auriculata의 순수한 잎</span>을 담았습니다.</h3>\n<img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_New/CASSIA/img02.png\"/>\n<p class=\"txt\">카시아는 <span class=\"bold\">트리트먼트 제품</span>입니다.</p>\n</div>\n</div>\n<div class=\"hara_hills_img\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img04.png\"/>\n<p>자연에 물들다</p>\n</div>\n<div class=\"selective_purchasing\">\n<h5>포장단위</h5>\n<div class=\"content\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_New/CASSIA/img03.png\"/>\n<p>하라힐즈는<br/>\n<span class=\"semi_bold\">1BOX에</span> <span class=\"large\">동일한 제품 10개</span><span class=\"semi_bold\">가</span> 들어있습니다.</p>\n</div>\n</div>\n<div class=\"precautions02\">\n<h5 class=\"regular\">사용 보관 시 유의사항</h5>\n<div class=\"content\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img08.png\"/>\n<p class=\"bold\">*개봉 후, 즉시 사용을 권합니다.</p>\n<p>순수한 파우더는 습기와 외부의 오염으로부터 취약할 수 있습니다.<br/>\r\n개봉 후 잘못된 보관으로 인하여 제품의 오염이 될 수 있습니다.</p>\n</div>\n</div>\n<div class=\"certification\">\n<div class=\"box_h5\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img09.png\"/>\n<h5>HARA HILLS Pvt. Ltd. <span class=\"regular\">인증 현황</span></h5>\n</div>\n<div class=\"content\">\n<div class=\"Box\">\n<div class=\"img\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img010_01.png\"/></div>\n<div class=\"txt\">\n<p>GMP (우수건강기능식품제조기준)</p>\n<p>GMP 이란?</p>\n<p>GMP는 우수한 품질의 건강기능식품을 제조하기 위한 기준으로 작업장 구조와 설비를 비롯해 원료 구입부터 생산ㆍ포장ㆍ출하까지 전 공정에 걸친 체계적인 관리 기준입니다.</p>\n</div>\n</div>\n<div class=\"Box\">\n<div class=\"img\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img010_02.png\"/></div>\n<div class=\"txt\">\n<p>ISO 9001 인증 획득!</p>\n<p>ISO 9001 이란?</p>\n<p>ISO 9001은 국제표준화기구(International Organiztion for Standardization)에서 제정·시행하고 있는 품질경영시스템에 관한 국제규격입니다.</p>\n</div>\n</div>\n<div class=\"Box\">\n<div class=\"img\"><img alt=\"\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn3.gcooperp.com/storage/global_image/HARA_HILLS/Organic_Pure_Star_Set/img010_03.png\"/></div>\n<div class=\"txt\">\n<p>ISO 14001 인증 획득!</p>\n<p>ISO 14001 이란?</p>\n<p>국제표준화기구에서 제정한 환경경영 체제에 관한 국제표준인 ‘ISO 14000 시리즈’ 중 하나로, ISO 14001 인증을 받는다는 것은 환경경영을 기업 경영의 방침으로 삼고 조직적으로 관리하는 체제를 갖추며 지속적인 환경개선을 이루어 나가고 있다는 것을 의미합니다.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div style=\"text-align:center;\">\n<a href=\"#\" rel=\"noopener\" target=\"_blank\"><img decoding=\"async\" loading=\"lazy\" src=\"https://vcshop.gcoop.com/images/icon_edu_materials.png\" style=\"width:220px;\"/></a>\n</div>\n</div>","info":[["품명","하라힐즈 오가닉 퓨어 카시아"],["용량","100g * 10ea"],["사용기간","제조일로부터 36개월"],["사용방법","1. 본품 100g과 물 300ml의 비율로 잘 혼합한 후, 마른 모발에 균등히 바릅니다.\n2. 약 60분 후에 미지근한 물로 잘 헹군 후 비누나 샴푸로 깨끗이 씻고 마지막에 따뜻한 물로 충분히 헹궈줍니다.\n(*용량은 모발의 양에 따라 적절히 증감합니다.)"],["화장품 제조업자 및 화장품 책임 판매 업자","Cultivator Natural Products Pvt. Ltd."],["제조국","인도"],["전성분","테너스카시아잎가루"],["기능성","일반화장품"],["주의사항","사용할 때의 주의사항\n1) 화장품 사용 시 또는 사용 후 직사광선에 의하여 사용부위가 붉은 반점, 부어오름 또는 가려움증 등의 이상 증상이나 부작용이 있는 경우에는 전문의 등과 상담할 것\n2) 상처가 있는 부위 등에는 사용을 자제할 것\n3) 보관 및 취급 시 주의사항\n가) 어린이의 손이 닿지 않는 곳에 보관할 것\n나) 직사광선을 피해서 보관할 것\n4) 눈에 들어 갔을 때에는 즉시 씻어낼 것.\n5) 눈에 들어가지 않도록 주의할 것."],["품질보증기준","본 상품의 품질보증 및 피해보상에 관한 사항은 관련 법률 및 공정거래위원회 고시 [소비자분쟁해결기준]에 따릅니다."],["소비자 상담관련 전화번호","02-555-6009\n지쿱 홈페이지(www.gcoop.com) 하단 소비자 상담센터 이용"]]}