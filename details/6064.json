\r\n                    width: 100%;\r\n                    top: 4%;\r\n                }\r\n\r\n                .Product_detail_page .key_img img {\r\n                    width: 100%;\r\n                }\r\n\r\n                .Product_detail_page .key_tit {\r\n                    width: 90%;\r\n                    margin: 0 auto;\r\n                    text-align: center;\r\n                    margin-top: 8%;\r\n                }\r\n\r\n                .Product_detail_page .key_tit h1 {\r\n                    font-family: 'GyeonggiBatang';\r\n                    font-weight: 600;\r\n                    font-size: 70px;\r\n                    color: #2f2725;\r\n                    line-height: 1.3;\r\n                    letter-spacing: 0.05em;\r\n                }\r\n\r\n                .Product_detail_page .key_tit img.logo {\r\n                    width: 31%;\r\n                    margin-top: 2vh;\r\n                }\r\n\r\n                .Product_detail_page .key_img .label_box {\r\n                    width: 80%;\r\n                    border-radius: 1vh;\r\n                    background-color: rgba(255, 255, 255, 0.15);\r\n                    padding: 3vh;\r\n                    position: absolute;\r\n                    bottom: 3%;\r\n                    left: 50%;\r\n                    transform: translateX(-50%);\r\n                    display: flex;\r\n                    justify-content: center;\r\n                }\r\n\r\n                .Product_detail_page .key_img .label_box p {\r\n                    font-family: 'GyeonggiBatang';\r\n                    font-size: 22px;\r\n                    color: #fff;\r\n                    margin-top: 2vh;\r\n                }\r\n\r\n                .Product_detail_page .key_img .label_box .Box {\r\n                    flex: 1 1 auto;\r\n                }\r\n\r\n                .Product_detail_page .key_img .label_box .Box img {\r\n                    width: 75%;\r\n                }\r\n\r\n             