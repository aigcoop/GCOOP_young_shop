-top: 120px;\r\n    }\r\n\r\n    .Product_DetailWrap .mt_150 {\r\n        margin-top: 150px;\r\n    }\r\n\r\n    .Product_DetailWrap .mt_200 {\r\n        margin-top: 200px;\r\n    }\r\n\r\n    .Product_DetailWrap .ml_10 {\r\n        margin-left: 10px;\r\n    }\r\n\r\n    /* PADDING CSS */\r\n    .Product_DetailWrap .pt_30 {\r\n        padding-top: 30px;\r\n    }\r\n\r\n    .Product_DetailWrap .pt_50 {\r\n        padding-top: 50px;\r\n    }\r\n\r\n    .Product_DetailWrap .pt_80 {\r\n        padding-top: 80px;\r\n    }\r\n\r\n    .Product_DetailWrap .pt_100 {\r\n        padding-top: 100px;\r\n    }\r\n\r\n    .Product_DetailWrap .pb_30 {\r\n        padding-bottom: 30px;\r\n    }\r\n\r\n    .Product_DetailWrap .pb_50 {\r\n        padding-bottom: 50px;\r\n    }\r\n\r\n    .Product_DetailWrap .pb_80 {\r\n        padding-bottom: 80px;\r\n    }\r\n\r\n    .Product_DetailWrap .pb_100 {\r\n        padding-bottom: 100px;\r\n    }\r\n\r\n    .Product_DetailWrap .pd_80 {\r\n        padding: 80px;\r\n    }\r\n\r\n    .Product_DetailWrap .pd_5p {\r\n        padding: 5%;\r\n    }\r\n\r\n    .Product_DetailWrap .pd_2em {\r\n        padding: 2em;\r\n    }\r\n\r\n    .Product_DetailWrap .plr_05em {\r\n        padding: 0 0.5em;\r\n    }\r\n\r\n    /* GRID · FLEX 스타일 */\r\n    .Product_DetailWrap .grid_2step {\r\n        display: grid;\r\n        grid-template-columns: repeat(2, 49%);\r\n        justify-content: space-between;\r\n    }\r\n\r\n    .Product_DetailWrap .grid_3step {\r\n        display: grid;\r\n        grid-template-columns: repeat(3, 30%);\r\n        justify-content: space-between;\r\n    }\r\n\r\n    .Product_DetailWrap .grid_txtList {\r\n        display: grid;\r\n        grid-template-columns: 2.4167em 1fr;\r\n        align-items: start;\r\n        gap: 2.0833em 1.25em;\r\n        text-align: left;\r\n    }\r\n\r\n    .Product_DetailWrap .flex_row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n    }\r\n\r\n    