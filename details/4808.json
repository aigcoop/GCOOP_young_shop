{"html":"<div class=\"product_detail\">\n<div align=\"center\" class=\"pdt_detail_img\">\n<img alt=\"제품 상세 공지(탑) - 온라인 가품 유통 주의 안내\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoopm.com/shop/storage/shop_image/Ww8yREXDVplPHT9vZS1WKnZe1DiprZ143KbzqknD.jpg\"/>\n</div>\n<div align=\"center\" class=\"pdt_detail_img\" style=\"padding:10px;\"><br/><br/><br/></div>\n</div>\n<div class=\"pdt_detail_img\">\n<style type=\"text/css\">@font-face {font-family:'NEXON Lv2 Gothic';src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_20-04@2.1/NEXON Lv2 Gothic.woff') format('woff');font-weight:normal;font-style:normal;}\r\n            .product_detail_wrap * {box-sizing:border-box;word-break:keep-all;}\r\n            .product_detail_wrap h1, h2, h3, h4, h5, h6, ul, ol, li, dl, dt, dd, p, div, span, section, i,  form, fieldset, input, table, tr, th, td, button, textarea, br {margin:0;padding:0;}\r\n            .product_detail_wrap ul, ol, li, dl, dt, dd {list-style:none;}\r\n            .product_detail_wrap img {width:auto;max-width:100%;margin:0 auto;}\r\n            .product_detail_wrap {position:relative;font-size:16px;font-weight:400;width:100%;max-width:1200px !important;margin:0 auto;padding:0 0 40px;letter-spacing:-0.5px;text-align:center;color:#2f2725;line-height:1.4;}\r\n\r\n            /* 공통 */\r\n            .product_detail_wrap h2 {font-size:3.75em;font-weight:700;letter-spacing:-2px;line-height:1.2;}\r\n            .product_detail_wrap h3 {font-size:1.875em;}\r\n            .product_detail_wrap .p0 {font-size:1.125em;}\r\n            .product_detail_wrap .p1 {font-size:1.5em;}\r\n            .product_detail_wrap .p2 {font-size:1.875em;}\r\n            .product_detail_wrap .p3 {font-size:2.25em;}\r\n            .product_detail_wrap .p4 {font-size:3em;}\r\n            .product_detail_wrap .p5 {font-size:3.75em;}\r\n            .product_detail_wrap p span, .product_detail_wrap h3 span, .product_detail_wrap h4 span {font-weight:700;}\r\n            .product_detail_wrap p, .product_detail_wrap h3, .product_detail_wrap h4 {transform:rotate(0.04deg)}\r\n            .product_detail_wrap .mt_10 {margin-top:10px;}\r\n            .product_detail_wrap .mt_20 {margin-top:20px;}\r\n            .product_detail_wrap .mt_30 {margin-top:30px;}\r\n            .product_detail_wrap .mt_40 {margin-top:40px;}\r\n            .product_detail_wrap .mt_50 {margin-top:50px;}\r\n            .product_detail_wrap .mt_60 {margin-top:60px;}\r\n            .product_detail_wrap .mt_80 {margin-top:80px;}\r\n            .product_detail_wrap .mt_100 {margin-top:100px !important;}\r\n            .product_detail_wrap .mt_120 {margin-top:120px;}\r\n            .product_detail_wrap .fw_300 {font-weight:300;}\r\n            .product_detail_wrap .fw_500 {font-weight:500;}\r\n            .product_detail_wrap .fw_600 {font-weight:600;}\r\n            .product_detail_wrap .lh_1 {line-height:1.2;}\r\n            .product_detail_wrap .lh_2 {line-height:2;}\r\n            .product_detail_wrap .tl {text-align:left;}\r\n            .product_detail_wrap .color_darkgray {color:#666;}\r\n            .product_detail_wrap .color_green {color:#045206;}\r\n            .product_detail_wrap .color_gray {color:#bfc0c0;}\r\n            .product_detail_wrap .color_orenge {color:#f6ae6a;}\r\n            .product_detail_wrap .color_white {color:#fff;}\r\n            .product_detail_wrap .bg_darkgray {background-color:#f2f2f2}\r\n            .product_detail_wrap .ybr {display:none;}\r\n            .product_detail_wrap .ls_1 {letter-spacing:1px}\r\n            .product_detail_wrap .ptr {position:relative;}\r\n\r\n            /* 키이미지 */\r\n            .product_key_img {position:relative;margin:0 !important;color:#4c4948;}\r\n            .product_key_img .key_txt_top {position:absolute;top:130px;left:10%;width:80%;}\r\n            .product_key_img .key_txt_top .logo {width:190px;margin:0 auto;}\r\n            .product_key_img .key_txt_top .text_01 {font-size:2.25em;margin-top:80px;}\r\n            .product_key_img .key_txt_top .text_01 span {color:#3e3a39;}\r\n            .product_key_img .key_txt_top .text_02 {font-size:4.5em;margin-top:30px;color:#3e3a39;}\r\n            .product_key_img .key_txt_top .text_03 {font-size:1.875em;margin-top:5px;font-weight:500;}\r\n            .product_key_img .key_txt_bottom {position:absolute;width:max-content;bottom:100px;left:50%;transform:translateX(-50%);border:#4d4640 1px solid;padding:10px 36px;border-radius:50px;font-size:1.5em;letter-spacing:0.5px;font-weight:500;}\r\n\r\n            /* POINT TITLE */\r\n            .product_detail_wrap .bull_txt {position:relative;margin-bottom:5px;}\r\n            .product_detail_wrap .bull_txt p {position:absolute;width:100%;top:50%;left:50%;transform:translate(-50%, -50%);}\r\n            .product_detail_wrap .bull_txt img {width:93px;}\r\n            .product_detail_wrap .point_num {font-family:NEXON Lv2 Gothic, sans-serif;font-style:normal;font-weight:300;background-color:#045206;font-size:2.25em;border-radius:50px;display:inline-block;padding:0.4em 1.3em 0.3em;margin-bottom:40px;color:#fff;}\r\n            .product_detail_wrap .point_num span {font-size:0.9em;margin-left:0.1em}\r\n            .product_detail_wrap .c_line {width:50px;height:0;border-bottom:#2f2725 2px solid;margin:40px auto;}\r\n            .product_detail_wrap .l_line {width:50px;height:0;border-bottom:#2f2725 2px solid;margin:40px 0;}\r\n            \r\n            /* POINT 01 */\r\n            .point_01 {}\r\n            .point_01 .dot_deco_txt {font-weight:500;margin-bottom:30px;}\r\n            .point_01 .dot_deco_txt span {position:relative;font-weight:500 !important;}\r\n            .point_01 .dot_deco_txt span::after {content:\"\";display:block;position:absolute;top:0;left:50%;width:10px;height:10px;background-color:#2f2725;border-radius:100%;transform:translate(-50%, -50%);}\r\n            .point_01 .c_img {width:37.68em;margin:40px auto 0;}\r\n            .point_01 .cont_box {width:84%;margin:0 auto;border:#045206 3px solid;border-radius:30px;overflow:hidden;}\r\n            .point_01 .cont_box .tit_box {background-color:#045206;color:#fff;padding:30px 0;}\r\n            .point_01 .cont_box .img_box {display:grid;grid-template-columns:repeat(3, 31%);justify-content:space-between;padding:50px 80px;}\r\n\r\n            /* POINT 02 */\r\n            .point_02 {}\r\n            .point_02 .cont_box {width:84%;margin:100px auto 0;display:grid;grid-template-columns:40% 1fr 40%;justify-content:space-between;align-items:center;}\r\n            .point_02 .cont_box .tit_box {background-color:#efefef;padding:10px 110px;border-radius:50px;margin-bottom:40px;display:inline-block;}\r\n            .point_02 .cont_box .bg_orenge {background-color:#f6ae6a;color:#fff;}\r\n            .point_02 .guide_table {width:84%;margin:80px auto 0;border-collapse:separate !important;border-spacing:4px 0 !important;}\r\n            .point_02 .guide_table tbody th {background-color:#efefef;vertical-align:middle;border-top:#a1a1a1 4px dotted;font-size:1.875em;color:#7d7d7d;font-weight:500;}\r\n            .point_02 .guide_table tbody td {padding:25px 0;vertical-align:middle;font-size:1.875em;border-top:#a1a1a1 4px dotted;}\r\n            .point_02 .guide_table tbody .old_cream {color:#7d7d7d;}\r\n            .point_02 .guide_table tbody .new_cream span {font-weight:500;}\r\n            .point_02 .guide_table tbody .sub_txt {font-size:0.8em;}\r\n            \r\n            /* POINT 03 */\r\n            .point_03 {background-color:#f2f2f3;padding:120px 0 0;}\r\n            .point_03 .cont_box_01 {position:relative;width:75%;margin:50px auto 0;}\r\n            .point_03 .cont_box_01 .txt_box {position:absolute;width:90%;top:45%;left:10%;display:grid;grid-template-columns:repeat(5, 20%);justify-content:space-between;align-items:center;}\r\n            .point_03 .cont_box_01 .txt_box .heat {width:3.5em;border:#f6ae6a 3px solid;background-color:#fff;padding:1em;border-radius:100%;}\r\n            .point_03 .cont_box_01 .bottom_txt {position:absolute;width:20%;bottom:10%;left:10%;}\r\n            .point_03 .cont_box_02 {width:85%;margin:80px auto 0;display:grid;grid-template-columns:49% 49%;justify-content:space-between;}\r\n            .point_03 .cont_box_02 .in_box {position:relative;padding:70px 50px 50px;background-color:#fff;border-radius:20px;}\r\n            .point_03 .cont_box_02 .in_box .tit_box {position:absolute;top:0;left:50%;transform:translate(-50%, -50%);padding:10px 30px;background-color:#045206;color:#fff;border-radius:50px;width:80%;}\r\n            .point_03 .cont_box_02 .in_box .txt_box {text-align:left;margin:0 auto;display:inline-block;}\r\n            .point_03 .cont_box_03 {width:85%;margin:80px auto 0;display:grid;grid-template-columns:repeat(3, 300px);justify-content:space-between;align-items:start;}\r\n            .point_03 .cont_box_03 .item_box {position:relative;}\r\n            .point_03 .cont_box_03 .item_box p {position:absolute;bottom:16%;left:50%;transform:translate(-50%, 50%);}\r\n            .point_03 .img_box_01 {width:75%;margin:120px auto 0;display:grid;grid-template-columns:340px 1fr;justify-content:space-between;align-items:center;}\r\n            .point_03 .img_box_02 {width:85%;margin:60px auto 0;display:grid;grid-template-columns:1fr 470px;justify-content:space-between;align-items:center;}\r\n\r\n            /* 임상시험 추가 */\r\n            .clincal_trial {width:75%;margin:120px auto 0;}\r\n            .clincal_trial .point_line::after {content:\"\";position:absolute;width:100%;height:0.7em;padding:0 5px;bottom:0;left:-5px;transform:translateY(15%);background-color:#fce7d2;z-index:-1;}\r\n            .clincal_trial .title_bar {width:fit-content;display:flex;background-color:#045206;margin:0 auto;padding:0.5em 2em 0.5em 0.5em;border-radius:100px;align-items:center;}\r\n            .clincal_trial .title_bar .t_num {color:#045206;background-color:#fff;border-radius:50px;padding:0.1em 0.3em 0.2em;}\r\n            .clincal_trial .title_bar .t_txt {margin-left:0.4em;}\r\n            .clincal_trial .cont_box {padding:70px 0;background-color:#f9f9f9;border-radius:10px;}\r\n            .clincal_trial .cont_box .table_grid {width:75%;display:grid;grid-template-columns:repeat(2, 50%);justify-content:space-between;border-radius:10px;border:1px solid #dadada;margin:0 auto;overflow:hidden;}\r\n            .clincal_trial .cont_box .table_grid li {display:flex;flex-direction:column;justify-content:center;padding:20px 0;}\r\n            .clincal_trial .cont_box .table_grid li img {width:63%;max-width:208px;}\r\n            .clincal_trial .cont_box .table_grid li:nth-of-type(even) {border-left:1px solid #dadada;}\r\n            .clincal_trial .cont_box .table_grid li:nth-of-type(-n+2) {background-color:#f2f2f2;}\r\n            .clincal_trial .cont_box .table_grid li:nth-of-type(n+3) {padding:30px 0;border-top:1px solid #dadada;}\r\n            .clincal_trial .cont_box .table_box {width:64%;border-radius:10px;border:1px solid #dadada;margin:0 auto;overflow:hidden;}\r\n            .clincal_trial .cont_box .table_box li img {width:75%;max-width:432px;}\r\n            .clincal_trial .cont_box .table_box li:nth-of-type(1) {background-color:#f2f2f2;padding:20px 0;}\r\n            .clincal_trial .cont_box .table_box li:nth-of-type(2) {padding:30px 0;border-top:1px solid #dadada;}\r\n            .clincal_trial .cont_graph {display:grid;grid-template-columns:repeat(2, 48.6%);justify-content:space-between;}\r\n            .clincal_trial .cont_graph .graph_box {border:1px solid #e2e2e2;padding-bottom:2em;}\r\n            .clincal_trial .cont_graph .graph_box .graph_name {width:max-content;position:absolute;top:0;left:50%;background-color:#222222;transform:translate(-50%, -50%);padding:0.4em 1em 0.5em;border-radius:50px;}\r\n            .clincal_trial .cont_graph .graph_box .decrease_blue {width:34.2466%;height:16.129%;color:#1a68a8;position:absolute;top:72.5806%;left:46.5753%;display:flex;flex-direction:column;justify-content:center;}\r\n            .clincal_trial .cont_graph .graph_box .decrease_red {width:34.2466%;height:16.129%;color:#bb2424;position:absolute;top:72.5806%;left:46.5753%;display:flex;flex-direction:column;justify-content:center;}\r\n            .clincal_trial .cont_graph .graph_box .grid_txt {display:grid;grid-template-columns:32.8767% 1fr 1fr 7.7626%;justify-content:space-between;}\r\n            .clincal_trial .testing_inst {border:1px solid #dadada;}\r\n            .clincal_trial .testing_inst ul {border-bottom:1px solid #dadada;display:grid;grid-template-columns:29% 1fr;}\r\n            .clincal_trial .testing_inst ul:last-of-type {border-bottom:none;}\r\n            .clincal_trial .testing_inst ul li {padding:0.8em 1.1em;display:flex;align-items:center;}\r\n            .clincal_trial .testing_inst ul li:nth-of-type(2) {border-left:1px solid #dadada}\r\n\r\n\r\n            /* POINT 04 */\r\n            .point_04 {}\r\n            .point_04 .cont_box_01 {background-color:#efefef;margin:50px auto 0;padding-bottom:100px;}\r\n            .point_04 .cont_box_01 .txt_box {width:75%;margin:30px auto 0;display:grid;grid-template-columns:49% 49%;justify-content:space-between;}\r\n            .point_04 .cont_box_01 .txt_box .in_box {position:relative;padding:70px 50px 50px;background-color:#fff;border-radius:20px;}\r\n            .point_04 .cont_box_01 .txt_box .in_box .tit_box {position:absolute;top:0;left:50%;transform:translate(-50%, -50%);padding:10px 30px;background-color:#f6ae6a;color:#fff;border-radius:50px;width:80%;}\r\n            .point_04 .cont_box_02 {background-color:#efefef;margin:0 auto;padding:0 15px 80px 80px;display:grid;grid-template-columns:1fr 552px;justify-content:space-between;align-items:start;column-gap:25px;}\r\n            .point_04 .cont_box_02 .m_txt {position:relative;letter-spacing:-3px;}\r\n            .point_04 .cont_box_02 .m_txt i {position:absolute;top:0;left:0;transform:translate(-120%, 20%);font-style:normal;}\r\n\r\n            /* POINT 05 */\r\n            .point_05 {}\r\n\r\n            /* POINT 06 */\r\n            .point_06 {position:relative;padding-top:240px;background-color:#efefef;}\r\n            .point_06 .cont_box_01 {position:absolute;top:120px;left:132px;}\r\n            .point_06 .cont_box_01 .img_box {width:480px;margin-top:40px;display:grid;grid-template-columns:repeat(3, 30%);justify-content:space-between;row-gap:36px;align-items:start;text-align:center;}\r\n\r\n            /* HOW TO USE */\r\n            .how_to {}\r\n\r\n            /* 더마테스트 엑셀런트 획득 */\r\n            .dermatest {background-color:#f4f4f4;padding:100px 0 120px;}\r\n\r\n            /* 권장 대상 */\r\n            .recommend {padding-top:100px;background:linear-gradient(to left, #e7e7e7,#ececec, #f4f4f3);}\r\n            .recommend .cont_box {position:relative;}\r\n            .recommend .cont_box .txt_box {position:absolute;width:max-content;left:50%;transform:translateX(-50%);top:65%;text-align:left;display:grid;grid-template-columns:33px 1fr;align-items:center;gap:20px 15px;background-color:#fff;border-radius:20px;padding:50px 60px;}\r\n\r\n            /* 브랜드 스토리 */\r\n            .brand_story {width:96%;padding:30px;margin:120px auto;display:flex;align-items:flex-start;justify-content:space-between;border:#e1e1e1 solid 1px;border-radius:10px;}\r\n            .brand_story .brand_story_img {width:40%;border-radius:10px;overflow:hidden;}\r\n            .brand_story .brand_story_info {width:56%;text-align:left;}\r\n            .brand_story .brand_story_info img {max-width:40%;}\r\n\r\n            /* 각종인증사항 */\r\n            .certifi_title {width:96%;margin:0 auto;border-radius:10px;overflow:hidden;position:relative;}\r\n            .certifi_title .title {position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);font-size:3em;font-weight:500;text-align:center;color:#fff;width:100%;line-height:1;}\r\n            .certifi_title .title span {font-size:0.5em;font-weight:500;}\r\n            .certifi {width:96%;margin:50px auto 0;display:flex;align-items:start;justify-content:space-between;text-align:left;}\r\n            .certifi .certifi_img {width:15%;}\r\n            .certifi .certifi_info {width:83%;}\r\n            .certifi .certifi_info .t_line {position:relative;font-weight:500;}\r\n            .certifi .certifi_info .t_line:after {content:\"\";width:100%;position:absolute;bottom:-1px;left:0;border-top:2px solid #c1c1c1;opacity:0.9;}\r\n\r\n            @media all and (max-width:1200px) {\r\n                .product_detail_wrap {font-size:15px;padding:0 0 3.5vw;overflow:hidden;}\r\n                .product_detail_wrap h2 {width:90%;margin-left:5%;}\r\n                .product_detail_wrap h3 {width:90%;margin-left:5%;}\r\n                .product_detail_wrap .mt_10 {margin-top:0.83vw;}\r\n                .product_detail_wrap .mt_20 {margin-top:1.66vw;}\r\n                .product_detail_wrap .mt_30 {margin-top:2.5vw;}\r\n                .product_detail_wrap .mt_40 {margin-top:3.33vw;}\r\n                .product_detail_wrap .mt_50 {margin-top:4.1667vw;}\r\n                .product_detail_wrap .mt_60 {margin-top:5vw;}\r\n                .product_detail_wrap .mt_80 {margin-top:6.6667vw;}\r\n                .product_detail_wrap .mt_100 {margin-top:8.3333vw !important;}\r\n                .product_detail_wrap .mt_120 {margin-top:10vw;}\r\n                .product_key_img .key_txt_top {top:10.83vw;}\r\n                .product_key_img .key_txt_top .logo {width:15.83vw;}\r\n                .product_key_img .key_txt_top .text_01 {margin-top:6.65vw;}\r\n                .product_key_img .key_txt_top .text_02 {margin-top:2.5vw;}\r\n                .product_key_img .key_txt_top .text_03 {margin-top:0.416vw;}\r\n                .product_key_img .key_txt_bottom {bottom:8.33vw;padding:0.83vw 3vw;}\r\n                .product_detail_wrap .bull_txt img {width:7.75vw;}\r\n                .product_detail_wrap .point_num {margin-bottom:3.34vw;}\r\n                .product_detail_wrap .c_line {width:4.2vw;margin:3.34vw auto;}\r\n                .product_detail_wrap .l_line {width:4.2vw;margin:3.34vw 0;}\r\n                .point_01 .dot_deco_txt {margin-bottom:2.5vw;}\r\n                .point_01 .dot_deco_txt span::after {width:0.83vw;height:0.83vw;}\r\n                .point_01 .c_img {margin:3.33vw auto;}\r\n                .point_01 .cont_box .tit_box {padding:2.5vw 0;}\r\n                .point_01 .cont_box .img_box {padding:4.2vw 6.7vw;}\r\n                .point_02 .cont_box {margin:8.33vw auto 0;}\r\n                .point_02 .cont_box img {width:16vw;}\r\n                .point_02 .cont_box div:nth-of-type(2) img {width:2.33vw;}\r\n                .point_02 .cont_box .tit_box {padding:0.83vw 8.33vw;margin-bottom:3.33vw;}\r\n                .point_02 .guide_table {margin:6.7vw auto 0;border-spacing:0.4vw 0 !important;}\r\n                .point_02 .guide_table tbody th {border-top:#a1a1a1 0.4vw dotted;}\r\n                .point_02 .guide_table tbody td {padding:2.5vw 0;border-top:#a1a1a1 0.4vw dotted;}\r\n                .point_03 {padding:10vw 0 0;}\r\n                .point_03 .cont_box_01 {margin:4.2vw auto 0;}\r\n                .point_03 .cont_box_01 .txt_box {width:90%;top:46%;left:10%;}\r\n                .point_03 .cont_box_02 {width:85%;margin:6.7vw auto 0;}\r\n                .point_03 .cont_box_02 .in_box {padding:6vw 4.2vw 4.2vw;border-radius:1.7vw;}\r\n                .point_03 .cont_box_02 .in_box .tit_box {padding:0.83vw 2.5vw;}\r\n                .point_03 .cont_box_03 {margin:6.7vw auto 0;grid-template-columns:repeat(3, 25vw);}\r\n                .point_03 .img_box_01 {margin:10vw auto 0;grid-template-columns:28.33vw 1fr;}\r\n                .point_03 .img_box_02 {margin:5vw auto 0;grid-template-columns:1fr 39.16vw;}\r\n                .clincal_trial {margin:10vw auto 0;}\r\n                .clincal_trial .point_line::after {padding:0 0.5vw;left:-0.5vw;}\r\n                .clincal_trial .cont_b