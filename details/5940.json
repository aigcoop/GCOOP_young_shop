r\n            .Product_DetailWrap .flex_c_auto {flex:auto;display:flex;justify-content:center;align-items:center;}\r\n\r\n            /* TABLE STYLE */\r\n            .Product_DetailWrap table{width:100%;padding:0;border:0;border-spacing:0px;border-collapse:collapse;font-size:unset;}\r\n            .Product_DetailWrap .Table_Style1 th {background-color:#f3f3f3;border:1px solid #ccc;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #ccc;color:#121212;font-weight:600;}\r\n            .Product_DetailWrap .Table_Style1 td {border:1px solid #ccc;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n            .Product_DetailWrap .Table_Style1 tr td:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;color:#724848;}\r\n            .Product_DetailWrap .Table_Style1 tr:last-child td:nth-child(3) {border-bottom:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style1 tr th:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;border-top:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style2 th {background-color:#f9f2f2;border:1px solid #e0d0c3;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #e1e1e1;color:#724848;}\r\n            .Product_DetailWrap .Table_Style2 td {border:1px solid #e0d0c3;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n\r\n            /* 기타 스타일 */\r\n            .Product_DetailWrap .w64 {width:64%;margin-left:18%;}\r\n            .Product_DetailWrap .w80 {width:80%;margin-left:10%;}\r\n            .Product_DetailWrap .w90 {width:90%;margin-left:5%;}\r\n            .Product_DetailWrap .mgAuto {margin-left:auto;margin-right:auto;}\r\n            .Product_DetailWrap .pos_r {position:relative;}\r\n            .Product_DetailWrap .wMax {width:max-content;}\r\n            .Product_DetailWrap .wFit {width:fit-content;}\r\n            .Product_DetailWrap .opac80 {opacity:0.8;}\r\n            .Product_DetailWrap .bdr_10 {border-radius:0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_10v {border-radius:0.8333em;}\r\n            .Product_DetailWrap .bdr_l_10 {border-radius:0.8333em 0 0 0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_r_10 {border-radius:0 0.8333em 0.8333em 0;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_Line {border:1px solid #d9d9d9;border-radius:0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .Round_Bar {display:inline-block;width:50%;border-radius:200px;padding:0.8em 1.5em 0.7em;}\r\n            .Product_DetailWrap .Round_Title {display:inline-block;border-radius:200px;padding:1.5em 3.5em 1.4em;}\r\n            .Product_DetailWrap .Round_TitleBar {display:inline-block;position:absolute;border-radius:200px;padding:0.6em 1.5em 0.5em;top:0;left:50%;transform:translate(-50%, -50%);}\r\n            .Product_DetailWrap .SpanBox {padding:0.1em 0.15em 0.05em;}\r\n            .Product_DetailWrap .Box_Shadow {-webkit-box-shadow:0 0 1.25em 0.5em rgba(0,0,0,0.04); box-shadow:0 0 1.25em 0.5em rgba(0,0,0,0.04);}\r\n            .Product_DetailWrap .Text_Underline {text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:0.25em;}\r\n            .Product_DetailWrap .ybr {display:none;}\r\n            .Product_DetailWrap .nbr {display:block;}\r\n\r\n            /* 브랜드 이미지 */\r\n            .BrandImg .Top_TextBox {position:absolute;top:31%;}\r\n            .BrandImg .Bottom_TextBox {position:absolute;bottom:9%;}\r\n\r\n            /* 키이미지 */\r\n            .KeyImg .Top_TextBox {position:absolute;top:6.6667%;}\r\n            .KeyImg .Bottom_TextBox {position:absolute;bottom:6%;}\r\n            .KeyImg .keyimg_grid {display:grid;grid-template-columns:11em auto;justify-content:center;align-items:center;}\r\n            .KeyImg .keyimg_grid .line {width:calc(100% + 2em);transform:translateX(-1em);padding-top:2.4em;margin-bottom:2.4em;grid-column: auto / span 2;border-bottom:1px dotted #696192;line-height:0;}\r\n            \r\n            /* 병풀은 바르는 것이라는 생각 */\r\n            .Telomera_GK .Top_TextBox {position:absolute;top:0;}\r\n            .Telomera_GK .Bottom_TextBox {position:absolute;bottom:0;}\r\n\r\n            /* 병풀의 새로운 발견 */\r\n            .Centella > div {position:absolute;}\r\n            .Centella > div:nth-child(1) {top:5.1852%;right:69.8958%;}\r\n            .Centella > div:nth-child(2) {top:56.2963%;right:79.8958%;}\r\n            .Centella > div:nth-child(3) {top:15.8519%;left:76.6667%;}\r\n            .Centella > div:nth-child(4) {top:67.2593%;left:69.375%;}\r\n\r\n            /* 최근 건강과 노화 관련 학술 연구 */\r\n            .Academic_Research li {border-bottom:1px dotted #1c0149;}\r\n            .Academic_Research li:nth-child(1) {border-bottom:0;}\r\n\r\n            /* 체내 적용 가능성 고려한 지쿱만의 모노화 기술 */\r\n            .Monoconversion {display:grid;grid-template-columns:27% 9.5% 27% 9.5% 27%;justify-content:space-between;row-gap:1.5em;}\r\n\r\n            /* 학계와 시장이 주목하는 부원료 5종 */\r\n            .Sub-Ingredient > p {position:absolute;}\r\n            .Sub-Ingredient > p:nth-child(1) {top:40.1724%;right:89.7135%;}\r\n            .Sub-Ingredient > p:nth-child(2) {bottom:1%;right:75.9115%;}\r\n            .Sub-Ingredient > p:nth-child(3) {top:40.1724%;left:89.7135%;}\r\n            .Sub-Ingredient > p:nth-child(4) {bottom:1%;left:73.6979%;}\r\n            .Sub-Ingredient_Grid li {display:grid;grid-template-columns:26.0417% 1fr;justify-content:space-between;align-items:center;}\r\n\r\n            /* 얇고 가벼운 필름, 언제 어디서나 */\r\n            .Anytime_Anywhere > div {position:absolute;height:26.2626%;}\r\n            .Anytime_Anywhere > div:nth-child(1) {top:0;right:67.4267%;}\r\n            .Anytime_Anywhere > div:nth-child(2) {top:32.3232%;right:67.4267%;}\r\n            .Anytime_Anywhere > div:nth-child(3) {top:64.6465%;right:67.4267%;}\r\n\r\n            .Air_Bubble {display:flex;align-items:center;width:80%;margin-left:10%;}\r\n            .Air_Bubble div:nth-child(1) {flex:0 44.72%;}\r\n            .Air_Bubble div:nth-child(2) {flex:1 auto;}\r\n\r\n            /* Reverse Aging Routine */\r\n            .Reverse_Aging:after {content: '';position:absolute;display:block;width:100%;height:1px;border-top:1px solid #edeaf5;top: 50%;left:0;z-index: 1;}\r\n            .Reverse_Aging li {z-index:2;}\r\n\r\n            /* CHECK LIST */\r\n            .Check_List {position:absolute;width:100%;top:50%;transform:translateY(-50%);}\r\n            .Check_List .tb_line::before {content: '';position:absolute;display:block;width:4.5%;height:1px;border-top:1px solid #696192;top:0;left:50%;transform:translateX(-50%);}\r\n            .Check_List .tb_line::after {content: '';position:absolute;display:block;width:4.5%;height:1px;border-bottom:1px solid #696192;bottom:0;left:50%;transform:translateX(-50%);}\r\n\r\n             /* 브랜드 스토리 */\r\n            .Brand_Grid {display:grid;grid-template-columns:40% 58%;justify-content:space-between;align-items:start;border:#ccc solid 1px;text-align:left;}\r\n            .Brand_Grid .logo_img {max-width:25% !important;margin-top:1em;}\r\n\r\n            @media all and (max-width:1200px) {\r\n                .Product_DetailWrap {padding-bottom:6vw;letter-spacing:-0.05vw;}\r\n                .Product_DetailWrap .mt_10 {margin-top:0.8333vw;}\r\n                .Product_DetailWrap .mt_20 {margin-top:1.6667vw;}\r\n                .Product_DetailWrap .mt_30 {margin-top:2.5vw;}\r\n                .Product_DetailWrap .mt_40 {margin-top:3.3333vw;}\r\n                .Product_DetailWrap .mt_50 {margin-top:4.1667vw;}\r\n                .Product_DetailWrap .mt_60 {margin-top:5vw;}\r\n                .Product_DetailWrap .mt_70 {margin-top:5.83337vw;}\r\n                .Product_DetailWrap .mt_80 {margin-top:6.6667vw;}\r\n                .Product_DetailWrap .mt_90 {margin-top:7.5vw;}\r\n                .Product_DetailWrap .mt_100 {margin-top:8.3333vw;}\r\n                .Product_DetailWrap .mt_110 {margin-top:9.1667vw;}\r\n                .Product_DetailWrap 