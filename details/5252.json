font-size: 1.75em;\r\n        }\r\n\r\n        .product_detail_wrap .ip3 {\r\n            font-size: 2em;\r\n        }\r\n\r\n        .product_detail_wrap .ip4 {\r\n            font-size: 3em;\r\n        }\r\n\r\n        .product_detail_wrap .ip5 {\r\n            font-size: 4.5em;\r\n        }\r\n\r\n        .product_detail_wrap .fw_600 {\r\n            font-weight: 600;\r\n        }\r\n\r\n        .product_detail_wrap .lh_10 {\r\n            line-height: 1;\r\n        }\r\n\r\n        .product_detail_wrap .lh_12 {\r\n            line-height: 1.2;\r\n        }\r\n\r\n        .product_detail_wrap .tl {\r\n            text-align: left;\r\n        }\r\n\r\n        /* 칼라 스타일 */\r\n        .product_detail_wrap .color_white {\r\n            color: #fff;\r\n        }\r\n\r\n        .product_detail_wrap .color_gray {\r\n            color: #626262;\r\n        }\r\n\r\n        .product_detail_wrap .color_purple {\r\n            color: #9c7bd6;\r\n        }\r\n\r\n        .product_detail_wrap .color_vpurple {\r\n            color: #4e0093;\r\n        }\r\n\r\n        .product_detail_wrap .bg_gray {\r\n            background-color: #fafafa;\r\n        }\r\n\r\n        .product_detail_wrap .bg_white {\r\n            background-color: #fff;\r\n        }\r\n\r\n        .product_detail_wrap .bg_purple {\r\n            background-color: #9c7bd6;\r\n        }\r\n\r\n        .product_detail_wrap .bg_dark {\r\n            background-color: #626262;\r\n        }\r\n\r\n        .product_detail_wrap .bg_darkgray {\r\n            background-color: #c9c9c9;\r\n        }\r\n\r\n        .product_detail_wrap .bg_lightgray {\r\n            background-color: #eee;\r\n        }\r\n\r\n        /* 간격 스타일 */\r\n        .product_detail_wrap .mg_auto {\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .product_detail_wrap .mt-05em {\r\n            margin-top: -0.5em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_02em {\r\n            margin-top: 0.2em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_03em {\r\n            margin-top: 0.3em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_04em {\r\n            margin-top: 0.4em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_08em {\r\n            margin-top: 0.8em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_1em {\r\n            margin-top: 1em;\r\n        }\r\n\r\n        .product_detail_wrap .mt_30 {\r\n            margin-top: 30px;\r\n        }\r\n\r\n        .product_detail_wrap .mt_50 {\r\n            margin-top: 50px;\r\n        }\r\n\r\n        .product_detail_wrap .mt_70 {\r\n            margin-top: 70px;\r\n        }\r\n\r\n        .product_detail_wrap .mt_100 {\r\n            margin-top: 100px;\r\n        }\r\n\r\n        .product_detail_wrap .mt_120 {\r\n            margin-top: 120px;\r\n        }\r\n\r\n        .product_detail_wrap .mt_150 {\r\n            margin-top: 150px;\r\n        }\r\n\r\n        .product_detail_wrap .mb_70 {\r\n            margin-bottom: 70px;\r\n        }\r\n\r\n        .product_detail_wrap .pd_1em {\r\n            padding: 1em;\r\n        }\r\n\r\n        .product_detail_wrap .pd_2em {\r\n            padding: 2em;\r\n        }\r\n\r\n        .product_detail_wrap .pd_3_2em {\r\n            padding: 3em 2em;\r\n        }\r\n\r\n        .product_detail_wrap .pd_3em {\r\n            padding: 3em;\r\n        }\r\n\r\n        .product_detail_wrap .ptb_60 {\r\n            padding: 60px 0;\r\n        }\r\n\r\n        .product_detail_wrap .ptb_100 {\r\n            padding: 100px 0;\r\n        }\r\n\r\n        .product_detail_wrap .ptb_120 {\r\n            padding: 120px 0;\r\n        }\r\n\r\n        .product_detail_wrap .plrb_2_3em {\r\n            padding: 0 2em 3em;\r\n        }\r\n\r\n        /* GRID · FLEX 스타일 */\r\n        .product_detail_wrap .grid_3step {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 30%);\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .product_detail_wrap .grid_txtList {\r\n            display: grid;\r\n            grid-template-columns: 1.8em 1fr;\r\n            align-items: start;\r\n            gap: 1em 0.5em;\r\n            text-align: left;\r\n        }\r\n\r\n        .flex_c {\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .flex_c_auto {\r\n            flex: auto;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        .flex_5em {\r\n            flex-basis: 5em;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        /* 기타 스타일 */\r\n        .product_detail_wrap .w75 {\r\n            width: 75%;\r\n            margin-left: 12.5%;\r\n        }\r\n\r\n        .product_detail_wrap .w80 {\r\n            width: 80%;\r\n            margin-left: 10%;\r\n        }\r\n\r\n        .product_detail_wrap .w90 {\r\n            width: 90%;\r\n            margin-left: 5%;\r\n        }\r\n\r\n        .product_detail_wrap .wMax {\r\n            width: max-content;\r\n        }\r\n\r\n        .product_detail_wrap .bdr_10 {\r\n            border-radius: 10px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .product_detail_wrap .ptr {\r\n            position: relative;\r\n        }\r\n\r\n        .product_detail_wrap .ybr {\r\n            display: none;\r\n        }\r\n\r\n        .product_detail_wrap .nbr {\r\n            display: block;\r\n        }\r\n\r\n        /* 키이미지 */\r\n        .product_keyimg .key_txtbox {\r\n            position: absolute;\r\n            top: 100px;\r\n        }\r\n\r\n        .product_keyimg .key_txtbox .gc_elixir_logo {\r\n            width: 18.75vw;\r\n            max-width: 225px;\r\n        }\r\n\r\n        .product_keyimg .key_txtbox .white_glow {\r\n            position: absolute;\r\n            width: 9.5vw;\r\n            max-width: 114px;\r\n            top: 50%;\r\n            right: 0;\r\n            transform: translate(85%, -12%);\r\n        }\r\n\r\n        .product_keyimg .key_txtbox p:nth-of-type(3) {\r\n            margin-top: 310px;\r\n        }\r\n\r\n        .point_num {\r\n            font-family: Cafe24Danjunghae;\r\n            background-color: #fff;\r\n            border: #1a1a1a 1px solid;\r\n            font-size: 1.5em;\r\n            border-radius: 50px;\r\n            line-height: 1;\r\n            display: inline-block;\r\n            padding: 0.6em 1.5em 0.4em;\r\n            letter-spacing: 0;\r\n        }\r\n\r\n        /* 디엘릭서 화이트 글로우로 환하게 채워지는 하루 */\r\n        .white_glow_start {\r\n            position: absolute;\r\n            top: 120px;\r\n        }\r\n\r\n        /* 디엘릭서 화이트 글로우의 특별함 */\r\n        .main_point {\r\n            display: grid;\r\n            grid-template-columns: 235px 1fr;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            column-gap: 50px;\r\n        }\r\n\r\n        .main_point .flex_box li {\r\n            display: flex;\r\n            align-items: center;\r\n            padding: 2em 0.5em;\r\n            border-bottom: 2px solid #e8e8e8;\r\n        }\r\n\r\n        .main_point .flex_box li:last-of-type {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .main_point .flex_box li img {\r\n            width: 5.1vw;\r\n            max-width: 61px;\r\n        }\r\n\r\n        .main_point .flex_box li p {\r\n            margin-left: 0.8em;\r\n        }\r\n\r\n        /* Point 01 */\r\n        .care_round_box {\r\n            border-radius: 135px;\r\n            overflow: hidden;\r\n            background-color: #fff;\r\n            padding-bottom: 1em;\r\n        }\r\n\r\n        /* Point 02 */\r\n        .collagen_grid_2step {\r\n            width: 60%;\r\n            margin-left: 20%;\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 47.5%);\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .collagen_grid_3step {\r\n            width: 60%;\r\n            margin-left: 20%;\r\n            display: grid;\r\n            grid-template-columns: 47.5% 1fr 47.5%;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n        }\r\n\r\n        .fish_scales {\r\n            width: 48.75vw;\r\n            max-width: 585px;\r\n            margin: 70px auto 0;\r\n        }\r\n\r\n        .fish_scales .fish_scales_text {\r\n            position: absolute;\r\n            bottom: 0;\r\n            left: 50%;\r\n            transform: translate(50%, 4%);\r\n        }\r\n\r\n        .collagen_absorption {\r\n            width: 80%;\r\n            max-width: 570px;\r\n            margin-left: 8%;\r\n        }\r\n\r\n        .collagen_absorption .txt_01 {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0px;\r\n            transform: rotate(-90deg) translate(-86%, -20%);\r\n            transform-origin: bottom left\r\n        }\r\n\r\n        .collagen_absorption .txt_02 {\r\n            position: absolute;\r\n            bottom: 4.5%;\r\n            right: 0;\r\n            transform: translateX(100%)\r\n        }\r\n\r\n        .collagen_absorption .txt_03 {\r\n            position: absolute;\r\n            bottom: 29%;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            border-radius: 10px;\r\n        }\r\n\r\n        .collagen_absorption .txt_03 p {\r\n            position: relative;\r\n            padding: 0.7em 1.5em;\r\n        }\r\n\r\n        /* .collagen_absorption .txt_03::after {content:\"\";position:absolute;bottom:-0.9em;left:50%;width:1.2em;height:1em;clip-path:polygon(50% 100%, 0 0, 100% 0);background-color:#9c7bd6;} */\r\n        .collagen_absorption .txt_03::after {\r\n            content: \"\";\r\n            position: absolute;\r\n            bottom: -1.5em;\r\n            left: 50%;\r\n            border: transparent 0.8em solid;\r\n            border-top-color: #9c7bd6;\r\n            display: inline-block;\r\n        }\r\n\r\n        .collagen_absorption .absorption_box {\r\n            position: absolute;\r\n            top: 1.8%;\r\n            right: 2%;\r\n            display: grid;\r\n            grid-template-columns: 15px 1fr;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            gap: 10px;\r\n            padding: 1.2em 1em;\r\n            background-color: #fff;\r\n        }\r\n\r\n        .collagen_absorption .absorption_box .colorball {\r\n            display: block;\r\n            width: 15px;\r\n            height: 15px;\r\n            border-radius: 100px;\r\n        }\r\n\r\n        /* Point 03 */\r\n        .phytoene_phytofluene {\r\n            width: 60%;\r\n            margin-left: 20%;\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 48%);\r\n            justify-content: space-between;\r\n        }\r\n\r\n        /* Point 04 */\r\n        .sr_materials {\r\n            width: 57.7%;\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .sr_materials p {\r\n            position: absolute;\r\n            width: 26.2319%;\r\n            height: 31.3149%;\r\n        }\r\n\r\n        .sr_materials p:nth-of-type(1) {\r\n            top: 11.5917%;\r\n            left: 0;\r\n        }\r\n\r\n        .sr_materials p:nth-of-type(2) {\r\n            top: 11.5917%;\r\n            right: 0;\r\n        }\r\n\r\n        .sr_materials p:nth-of-type(3) {\r\n            bottom: 10.2076%;\r\n            left: 3.4783%;\r\n        }\r\n\r\n        .sr_materials p:nth-of-type(4) {\r\n            bottom: 10.0346%;\r\n            right: 14.4928%;\r\n        }\r\n\r\n        /* Point 05 */\r\n        .phytonutrient div {\r\n            position: absolute;\r\n        }\r\n\r\n        .phytonutrient div:nth-of-type(1) {\r\n            width: 25.4444%;\r\n            bottom: 0;\r\n            left: 0;\r\n        }\r\n\r\n        .phytonutrient div:nth-of-type(2) {\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%);\r\n        }\r\n\r\n        .phytonutrient div:nth-of-type(3) {\r\n            width: 25.4444%;\r\n            bottom: 0;\r\n            right: 0;\r\n        }\r\n\r\n        .Phytochemical {\r\n            position: absolute;\r\n            top: 11.9%;\r\n        }\r\n\r\n        .Phytochemical_grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(5, 20%);\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .Phytochemical_grid li {\r\n            padding: 1em 0;\r\n            border-bottom: 1px dashed #c1c1c1;\r\n        }\r\n\r\n        .Phytochemical_grid li:nth-of-type(odd) {\r\n            background-color: rgba(255, 255, 255, .2);\r\n        }\r\n\r\n        .Phytochemical_grid li:nth-of-type(even) {\r\n            background-color: rgba(27, 27, 27, .05);\r\n        }\r\n\r\n        .Phytochemical_grid li:nth-of-type(n+6) {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .Phytochemical_grid li:nth-of-type(2),\r\n        .Phytochemical_grid li:nth-of-type(4),\r\n        .Phytochemical_grid li:nth-of-type(7),\r\n        .Phytochemical_grid li:nth-of-type(9) {\r\n            border-left: 1px dashed #c1c1c1;\r\n            border-right: 1px dashed #c1c1c1;\r\n        }\r\n\r\n        /* 권장 대상 */\r\n        .recommended_grid {\r\n            display: grid;\r\n            grid-template-columns: 410px 1fr;\r\n            justify-content: space-between;\r\n            column-gap: 3em;\r\n        }\r\n\r\n        /* 업그레이드된 콜라겐 제품을 만나보세요! */\r\n        .upgrade_grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr 40% 40%;\r\n            justify-content: space-between;\r\n            padding: 30px 0;\r\n        }\r\n\r\n        .upgrade_grid li {\r\n            z-index: 2;\r\n            border-bottom: 1px solid #ddd;\r\n            padding: 1em 0;\r\n        }\