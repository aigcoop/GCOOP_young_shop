{"html":"<div class=\"product_detail\">\n<div align=\"center\" class=\"pdt_detail_img\">\n<img alt=\"제품 상세 공지(탑) - 온라인 가품 유통 주의 안내\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoopm.com/shop/storage/shop_image/Ww8yREXDVplPHT9vZS1WKnZe1DiprZ143KbzqknD.jpg\"/>\n</div>\n<div align=\"center\" class=\"pdt_detail_img\" style=\"padding:10px;\"><br/><br/><br/></div>\n</div>\n<div class=\"pdt_detail_img\">\n<style type=\"text/css\">/* 기본 */\r\n        @font-face {\r\n            font-family: 'Cafe24Danjunghae';\r\n            src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_twelve@1.1/Cafe24Danjunghae.woff') format('woff');\r\n            font-weight: normal;\r\n            font-style: normal;\r\n        }\r\n\r\n        @font-face {\r\n            font-family: 'NEXON Lv2 Gothic Light';\r\n            src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_20-04@2.1/NEXON Lv2 Gothic Light.woff') format('woff');\r\n            font-weight: normal;\r\n            font-style: normal;\r\n        }\r\n\r\n        @font-face {\r\n            font-family: 'NEXON Lv2 Gothic';\r\n            src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_20-04@2.1/NEXON Lv2 Gothic.woff') format('woff');\r\n            font-weight: normal;\r\n            font-style: normal;\r\n        }\r\n\r\n        @font-face {\r\n            font-family: 'iceJaram-Rg';\r\n            src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2307-2@1.0/iceJaram-Rg.woff2') format('woff2');\r\n            font-weight: normal;\r\n            font-style: normal;\r\n        }\r\n\r\n        .font_NGl {\r\n            font-family: 'NEXON Lv2 Gothic Light', sans-serif;\r\n        }\r\n\r\n        .font_ICj {\r\n            font-family: 'iceJaram-Rg';\r\n        }\r\n\r\n        .product_detail_wrap * {\r\n            box-sizing: border-box;\r\n            word-break: keep-all;\r\n            word-wrap: break-word;\r\n        }\r\n\r\n        .product_detail_wrap ul,\r\n   