{"html":"<div class=\"product_detail\">\n<div align=\"center\" class=\"pdt_detail_img\">\n<img alt=\"제품 상세 공지(탑) - 온라인 가품 유통 주의 안내\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoopm.com/shop/storage/shop_image/Ww8yREXDVplPHT9vZS1WKnZe1DiprZ143KbzqknD.jpg\"/>\n</div>\n<div align=\"center\" class=\"pdt_detail_img\" style=\"padding:10px;\"><br/><br/><br/></div>\n</div>\n<div class=\"pdt_detail_img\">\n<style type=\"text/css\">/*------------------- common --------------------*/\r\n.product_detail_page h1, h2, h3, h4, h5, h6, ul, ol, li, dl, dt, dd, p, form, fieldset, input, table, tr, th, td, button, textarea {margin:0;padding:0;}\r\n.product_detail_page .clear:after{clear:both;content:'''';display:block;}\r\n.product_detail_page *{box-sizing: border-box;}\r\n.product_detail_page ul{list-style:none;padding:0;margin:0}\r\n.product_detail_page {width: 100%;max-width:1200px; margin: 0 auto; padding: 0; font-family: ''Noto Sans KR'', sans-serif;text-align: center;font-weight: 400;letter-spacing: -0.05em;word-break: keep-all;}\r\n.product_detail_page p {color: #666;font-weight: 400;font-size: 22px;}\r\n.product_detail_page p span {color: #333;font-weight: 500;}\r\n.product_detail_page p.sub_p {width: 80%;margin: 0 auto;margin-bottom: 3%;}\r\n.product_detail_page h5 {font-weight: 500;font-size: 25px;color: #fff;display: inline;background-color: #c3d433;padding: 0 0.7%;}\r\n.product_detail_page .h5_bar {width: 2%;margin: 0 auto;border-bottom: 3px solid #70abff;position: absolute;left: 50%;bottom: 0;transform: translateX(-50%);z-index: 0;line-height: 1;opacity: 25%;}\r\n.product_detail_page h2 {display:inline-block;font-weight: 600;font-size: 60px;text-align: center;color: #fff;margin: 0 auto;margin-top: 2%;margin-bottom: 3%; /*3%*/letter-spacing: -1px;position:relative}\r\n.product_detail_page h2 span {font-weight: 300;color:#000;}\r\n.product_detail_page h3 {font-weight: 600;font-size: 50px;text-align: center;color: #000;width: 90%;margin: 0 auto;margin-top: 1%;margin-bottom: 3%; /*3%*/}\r\n.product_detail_page h3 span {font-weight: 300;}\r\n.product_detail_page img {max-width: 100%;}\r\n.product_detail_page .tit-desc{font-size:26px;line-height:1.4;font-weight:300;color:#333}\r\n.product_detail_page .tit-desc .highlight{border-bottom:1px solid #666666;color:#333;font-weight:600}\r\n.product_detail_page .section {width: 100%;margin: 0 auto;box-sizing: border-box;}\r\n\r\n/**브랜드스토리**/\r\n.brand_story .point_tit {color: #000;font-size:60px;font-weight: 700;text-align: center;margin-top: 1%;}\r\n.brand_story .point_tit span { font-weight: 400;}\r\n.brand_story {width: 95%;height: auto;border: 1px solid #b1b1b1;margin: 0 auto;margin-top: 8%;/*margin-bottom: 8%;*/padding-bottom: 2%;}\r\n.brand_story .rounded {width: 200px;background-color: #403025;border:2px solid #000;padding:0.1em 1em;border-radius: 3em;-moz-border-radius: 3em;-webkit-border-radius: 3em;color: #fff;margin: 0 auto;font-size: 1.2em;line-height: 1.2em;margin-top: -1.7%;text-align: center;}\r\n.brand_story .content {width: 93%;margin: 0 auto;text-align: left;margin-top: 3%;margin-bottom: 3%;}\r\n.brand_story .content .img, .brand_story .content .text {display: inline-block;vertical-align: middle;}\r\n.brand_story .content .img {width: 50%;}\r\n.brand_story .content .img img { width: 100%;}\r\n.brand_story .content .text { text-align: left;width: 45%;margin-left: 3%;word-break: keep-all;}\r\n.brand_story .brand_logo { width: 40%;}\r\n.brand_story .brand_logo img {width: 100%;}\r\n.brand_story .content .bd {width: 8%;height: 2px;background-color: #666;margin-top: 5%;}\r\n.brand_story .content .text p {color: #666;font-size: 22px;font-weight: 300;margin-top: 3%;line-height:1.6}\r\n.brand_story .content .text p span {font-weight: 500;}\r\n.brand_story .content .text p.subject{font-size:60px;color:#000;margin-top:0;font-weight:600}\r\n.brand_story .content .text p.bold{color: #333;font-weight: 600;font-size:24px;}\r\n\r\n/**건강 정보**/\r\n.health_information {width: 100%;padding: 7% 0;}\r\n.health_information .hinfo_info_tit {width: 95%;margin: 0 auto;}\r\n.hinfo_info_subject {position: relative;}\r\n.hinfo_info_subject h2 {width: 100%;position: absolute;top: 50%;left: 50%;transform: translate(-50%, -50%);font-size: 60px;font-weight: 700;text-align: center;text-transform: uppercase;color: #fff;}\r\n.hinfo_info_subject h2 span {font-size: 30px;color:#fff;}\r\n.health_information .content {width:95%;margin: 0 auto;padding-top: 5%;}\r\n\r\n/**각종인증사항**/\r\n.certifications {width: 100%;padding-top: 3%; /*10%*/padding-bottom: 8%;margin-bottom: 8%;}\r\n.certifications .certifi_info_tit {width: 95%;margin: 0 auto;}\r\n.certifi_info_subject {position: relative;}\r\n.certifi_info_subject h2 {font-size: 60px;font-weight: 700;text-align: center;position: absolute;color: #fff;margin:0;width: 100%;top:50%;transform: translateY(-50%);}\r\n.certifi_info_subject h2 span.light {font-weight:300;color:#fff;}\r\n.certifi_info_subject h2 span.sm-text {font-size: 30px;color:#fff;display:block;}\r\n.certifications img {width: 100%;}\r\n.certifi_info_content img {}\r\n.certifi_01 {width: 90%;margin: 0 auto;text-align: left;margin-top: 5%;}\r\n.certifi_01 .certifi_01_img {display: inline-block;}\r\n.certifications h5 {font-size: 25px;font-weight: 700;color: #000;background: none;display: block;padding: 0;position: relative;opacity: 1;text-transform: none;}\r\n.certifications h6 {font-size: 22px;font-weight: 700;color: #333;margin-top: 1.2%;display: inline-block;}\r\n.certifications h6 span {border-bottom: 1px solid #c1c1c1;}\r\n.certifications p {font-size: 16px;color: #555;line-height: 24px;margin-top: 1.5%;}\r\n.certifi_01_content {display: inline-block;width: 80%;margin-left: 2.5%;vertical-align: top;}\r\n\r\n/*common-sectionnumber(circle)*/\t\r\n.product_detail_page .section-num{position:relative;margin:1% 0}\r\n.product_detail_page .section-num:before{content:'''';position:absolute;top:50%;left:5%;transform:translateY(-50%);height:2px;width:36%;background-color:#333;}\r\n.product_detail_page .section-num:after{content:'''';position:absolute;top:50%;right:5%;transform:translateY(-50%);height:2px;width:36%;background-color:#333;}\r\n.product_detail_page .section-num .round {display: inline-block;width: 125px;height: 125px;border: 2px solid #333333;border-radius: 75px;-moz-border-radius: 75px;-webkit-border-radius: 75px;margin: 0 auto;text-align: center;text-transform: uppercase;position:relative;}\r\n.product_detail_page .section-num .round p {font-size: 20px;color: #333333;line-height: 30px;position:absolute;left:50%;top:50%;transform:translate(-50%, -50%)}\r\n.product_detail_page .section-num .round p span {font-size: 32px;font-weight: 700;color: #333333;font-family: sans-serif;}\r\n/*----------------- section -----------------*/\r\n.product_detail_page{color:#000}\r\n.product_detail_page .content .title{font-size:34px;line-height:1.4;font-weight:300;color:#000;font-weight:600;margin-bottom:20px;}\r\n.product_detail_page .content .title span{font-weight:300}\r\n.product_detail_page .content .sm-title{font-size:26px;line-height:1.4;font-weight:300;color:#333}\r\n\r\n\r\n\r\n/*---------------------------------- custom content ----------------------------------*/\r\n/* section-title */\r\n.product_detail_page .title-sub-container{}\r\n.product_detail_page .title-sub-container h5{z-index: 1;position: relative;font-weight: 600;font-size: 1.5em;color: #fff;display: inline-block;background:#ad2d2c;padding:0 0.25em;}\r\n/* .product_detail_page .title-sub-container h5:before{z-index: -1;content: '''';background-color: #a2c7e4;padding: 25px;border-radius: 50%;position: absolute;left: 50%;top: 50%;transform: translate(-50%, -50%);}\r\n.product_detail_page .title-sub-container h5:after{z-index: -1;content: '''';background-color: #a2c7e4;padding: 10px;border-radius: 50%;position: absolute;left: 52%;top:-28px;transform: translateX(-25%);} */\r\n\r\n.product_detail_page .title-container{position:relative}\r\n.product_detail_page .title-container h2 {font-size:4.4em;min-width:250px;font-weight:600;line-height:1.3;padding: 0px 35px 10px 35px;color:#0b0b0b}\r\n.product_detail_page .title-container h2 span{color:#0b0b0b;}\r\n.product_detail_page .line-block{border-bottom:1px solid #dddddd;width:87%;margin:0 auto;margin-top:-2px;}\r\n\r\n\r\n/* 키이미지 */\r\n.product_detail_page .key_img {position: relative;padding-bottom:3em;}\r\n.product_detail_page .key_box {position: absolute;width: 100%;}\r\n.product_detail_page .key_box.top {position: absolute;width: 100%;top:12%;}\r\n.product_detail_page .key_img img {width: 100%;}\r\n.product_detail_page .key_box .key_label{min-width:50%;position:relative;display:inline-block;border:1px solid #000;padding:15px 60px;color:#343434}\r\n.product_detail_page .key_box .key_label .label_text{font-size:1.8em;font-weight:500;}\r\n.product_detail_page .key_box .key_label .label_tit{position: absolute;top:-0.8em;font-size:1.2em;background:#fff;padding:0 15px;left:50%;transform: translateX(-50%);font-weight:500;letter-spacing:1px;}\r\n.product_detail_page .key_tit {margin: 0 auto;text-align: center;padding:0 4%}\r\n.product_detail_page .key_box .key_tit .p01 {margin: 0 auto;color: #343434;font-size: 31px;font-weight: 500;margin-top: 4%;}\r\n.product_detail_page .key_box .key_tit .p01 span {font-weight: 600;}\r\n.product_detail_page .key_box h1 {font-weight: 500;font-size:6em;letter-spacing: -0.02em;line-height:1.3;color:#330e0e;margin-top:0.2em;}\r\n.product_detail_page .key_box h1 span{font-weight:300}\r\n.product_detail_page .key_tit .sub-tit{font-size:1.4em;color:#3d3d3d;letter-spacing: 0.5px;font-weight: 500;padding:0}\r\n.product_detail_page .key_tit .sub-tit span{font-weight:400}\r\n.product_detail_page .key_tit .sub-tit small{font-weight:400}\r\n.product_detail_page .key_tit>.tit-desc{color:#660300;line-height:1.6;margin-top:3.5em;}\r\n.product_detail_page .key_tit>.tit-desc .text1{font-size: 1.5em;font-weight: 600;line-height:1}\r\n.product_detail_page .key_tit>.tit-desc .text2{font-size: 1.5em;font-weight: 300;margin-top:1em}\r\n.product_detail_page .features {width: 100%;position: absolute;    bottom: 0;}\r\n.product_detail_page .features .feature-box {display: inline-block;vertical-align: middle;padding:0 4%;margin:1% 0;position:relative}\r\n.product_detail_page .features .feature-box:after{content:'''';width:1px;height:36px;position:absolute;top:50%;right:0;margin-top:-18px;background:rgba(0,0,0,0.1)}\r\n.product_detail_page .features .feature-box:nth-child(4):after{content:none;}\r\n.product_detail_page .features .feature-box:last-child:after{content:none;}\r\n.product_detail_page .features .feature-box:last-child {margin-right: 0;}\r\n.product_detail_page .features p {color: #3b3b3b;font-weight: 400;line-height:1.3;font-size:1.7em;}\r\n\r\n/*quantity-info*/\r\n.quantity-info{margin:0 auto 1em auto;padding:0 5%;}\r\n.quantity-info .tit{font-size: 1.8em;margin-bottom: 0.5em;font-weight: 600;color: #333;}\r\n.quantity-info .tit span.light{font-weight:300;color:#666}\r\n.quantity-info .sub-tit{font-size: 1.8em;margin-bottom: 0.5em;font-weight: 600;color: #333;padding:0}\r\n.quantity-info .desc{color: #333;text-align: left;font-size: 1.3em;font-weight: 300;}\r\n.quantity-info .desc span{font-weight:500}\r\n.quantity-info .list-type-desc{text-align:left;font-weight:300;padding:3em 0;}\r\n.quantity-info .list-type-desc ul li{position:relative;font-size:1.3em;padding-left:1.2em;}\r\n.quantity-info .list-type-desc ul li span.num{position:absolute;left:0;}\r\n\r\n\r\n\r\n.section .content .content-desc>.desc{font-size:2.4em;color:#666;margin-bottom:2em;}\r\n\r\n/*point01*/\r\n.point01.section{padding:3% 0 0 0;}\r\n.point01 .about-product{box-shadow: 1px 1px 10px rgba(0,0,0,0.15);margin:0 5% 10%;padding:4em 2em;}\r\n.point01 .about-product .tit{font-size:3.3em;font-weight:600;color:#0b0b0b;position:relative;display:inline-block;padding:0 0.2em;margin-bottom:0.7em;}\r\n.point01 .about-product .tit::after{z-index:-1;content:'''';display:block;background-color:#fae6e6;height:0.7em;position:absolute;left:0;bottom:0;width:100%;}\r\n.point01 .about-product .desc{font-size:2.2em;color:#444444}\r\n.point01 .content{}\r\n.point01 .content .content-desc{color:#666;}\r\n.point01 .content .group1{margin:10em 0 10em 0;position:relative}\t\r\n.point01 .content .group1 .img-box{width:50%;margin:0 auto;}\r\n.point01 .content .group1 .img-box img{display:block;margin:0 auto;}\r\n.point01 .content .group1 .text-group li{position:absolute}\r\n.point01 .content .group1 .text-group li .desc{font-size:2.4em;color:#fff;background-color:#ad2d2c;line-height:1.4;border-radius: 1.8em;padding: 0.25em 1em;font-weight:500}\r\n.point01 .content .group1 .text-group .text1{top:-14%;left:50%;transform: translateX(-50%);}\r\n.point01 .content .group1 .text-group .text2{top:20%;right:14%;}\r\n.point01 .content .group1 .text-group .text3{bottom:18%;right:8%}\t\r\n.point01 .content .group1 .text-group .text4{bottom:-15%;left:51%;transform: translateX(-50%);}\r\n.point01 .content .group1 .text-group .text4 .desc{padding-left:2em;padding-right:2em;}\r\n.point01 .content .group1 .text-group .text5{bottom:20%;left:8%;}\r\n.point01 .content .group1 .text-group .text6{top:22%;left:3%;}\r\n\r\n/*point02*/\r\n.point02.section{padding:4% 0 5% 0;}\r\n.point02 .content .group1 .img-box{width:87%;margin:0 auto;display:inline-block;position: relative;}\t\r\n.point02 .content .group1 .img-box img{z-index: -1;position:absolute;top:50%;left:50%;transform: translate(-50%, -50%);}\r\n.point02 .content .group1 .img-box .inner-text{box-sizing:border-box;padding:3.5em 5em;color:#fff;text-align:left;width:100%;overflow:hidden;position:relative;}\r\n.point02 .content .group1 .img-box .inner-text:before{content:'''';position:absolute;left:2em;top:2em;padding:1.5em;border:2px solid #fff;border-right:0;border-bottom:0;}\r\n.point02 .content .group1 .img-box .inner-text:after{content:'''';position:absolute;right:2em;bottom:2em;padding:1.5em;border:2px solid #fff;border-left:0;border-top:0;}\r\n.point02 .content .group1 .img-box .inner-text .tit{margin-bottom:0.5em;;border-bottom:1px solid #fff;font-weight:500;font-size:2.2em;display:inline-block;}\r\n.point02 .content .group1 .img-box .inner-text .desc{font-size:1.9em;font-weight:300;line-height:1.4}\t\r\n\r\n/*point03*/\r\n.point03.section{margin:5% 0 9% 0}\r\n.point03 .content{padding:0 5%}\r\n.point03 .content .group1{margin:0 auto;}\t\r\n.point03 .content .group1 li{float:left;width:calc(33.333333% + 3.333333%);position:relative}\t\r\n.point03 .content .group1 li:nth-child(2) img{opacity: 0.8;z-index: 1;position: relative;}\r\n.point03 .content .group1 li:first-child{margin-right:-5%}\r\n.point03 .content .group1 li:last-child{margin-left:-5%}\r\n.point03 .content .group1 li .label{position:relative}\r\n.point03 .content .group1 li .label:before{content: '''';width: 1px;height: 4em;position: absolute;background: rgba(0,0,0,0.15);z-index: 1;top: -1em;}\r\n.point03 .content .group1 li .label .tit{font-size:2.4em;line-height:1.2;font-weight:500;padding-top:2em}\r\n.point03 .content .group1 li .label .sub-tit{font-size: 18px;font-weight: 300;font-style: italic;margin-top: 3px;padding:0;color:#fff;}\t\r\n\r\n/*point04*/\r\n.point04.section {background-color:#f9f9f9;padding:9% 0 2%}\t\r\n.point04 .content .group1{padding:5%}\t\r\n.point04 .content .group1 .group-container{background-color:#fff;padding: 7% 2%;}\r\n.point04 .content .group1 .group-container .info1{float:left;width:45%}\t\r\n.point04 .content .group1 .group-container .info1 .img-box{width:53%;margin:0 auto;}\r\n.point04 .content .group1 .group-container .info1 .tit{background-color: #ad2d2c;color: #fff;border-radius: 3em;display: inline-block;font-size: 1.5em;padding: 0.5em 1.5em;margin: 1em 0 1.2em 0;font-weight:300}\r\n.point04 .content .group1 .group-container .info1 .desc{color:#666;font-size:1.6em;}\r\n.point04 .content .group1 .group-container .info2{float:right;width:55%;position:relative}\t\r\n.point04 .content .group1 .group-container .info2 .img-box{width:70%;margin:0 auto;position:relative}\r\n.point04 .content .group1 .group-container .info2 .img-box span{color:#000;position:absolute;    padding: 2px 10px;display:block;}\r\n.point04 .content .group1 .group-container .info2 .img-box .text1{background-color: #fef9eb;bottom:45%;left:-7%;}\t\r\n.point04 .content .group1 .group-container .info2 .img-box .text2{top:-3%;right:-3%}\t\r\n.point04 .content .group1 .group-container .info2 .img-box .text3{background-color: #d3f0f7;top:37%;right:-18%;}\t\r\n.point04 .content .group1 .group-container .info2 .img-box .text4{background-color: #fef9eb;right: -15%;bottom: 31%;}\t\r\n.point04 .content .group1 .group-container .info2 .img-box .text5{background-color: #fef9eb;right: -12%;bottom: 3%;}\t\r\n.point04 .content .group1 .group-container .label{color:#000;font-size:2em;line-height:1.6;margin-top:1em;display:block;}\t\r\n.point04 .content .group1 .group-container .label span{border-bottom:1px solid}\r\n.point04 .content .group1 .note{text-align:left;color:#666;margin:1em 0;font-size:1.6em}\t\r\n\r\n/*point05*/\r\n.point05.section {padding:9% 0}\t\r\n.point05 .content .img-box{width:47%;margin:0 auto;float:left;padding-left:5%;box-sizing: border-box;}\t\r\n.point05 .content .content-desc{width:49%;float:right;text-align:left;}\r\n.point05 .content .content-desc h2{color:#333;text-align:left;font-size:3.8em;margin:0;line-height:1.3}\r\n.point05 .content .content-desc .desc{text-align: left;color: #666;font-size: 1.9em;margin-top:1em;line-height:1.4}\t\r\n\r\n/*point06*/\r\n.point06.section{padding: 0 0 9% 0;}\t\r\n.point06 .content .group1{margin:0 auto;padding:0 5%}\t\r\n.point06 .content .group1 li{display:inline-block;width:calc(33.333333% + 3.333333%);position:relative;vertical-align:top;}\t\r\n.point06 .content .group1 li:nth-child(2) img{opacity: 0.8;z-index: 1;position: relative;}\r\n.point06 .content .group1 li:first-child{margin-right:-5%}\r\n.point06 .content .group1 li .label{position:relative}\r\n.point06 .content .group1 li .label:before{content: '''';width: 1px;height: 4em;position: absolute;background: rgba(0,0,0,0.15);z-index: 1;top: -1em;}\r\n.point06 .content .group1 li .label .tit{font-size:2.4em;line-height:1.2;font-weight:500;padding-top:2em}\r\n.point06 .content .group1 li .label .sub-tit{font-size: 18px;font-weight: 300;font-style: italic;margin-top: 3px;padding:0;color:#fff;}\t\r\n\r\n/*point07*/\r\n.point07 .content .group1 .img-box{margin:0 auto;display:inline-block;position: relative;}\t\r\n.point07 .content .group1 .img-box .inner-text{box-sizing:border-box;position:absolute;top:50%;left:50%;transform:translate(-50%, -50%); padding:5%;text-align:left;width:100%}\r\n.point07 .content .group1 .img-box .inner-text .tit{margin-top:0.25em;margin-bottom:0.7em;font-weight:600;font-size:4.4em;display:inline-block;}\r\n.point07 .content .group1 .img-box .inner-text .tit span{font-weight:300}\r\n.point07 .content .group1 .img-box .inner-text .desc{font-size:2.4em;line-height:1.6;color:#555555;width:70%;font-weight:400}\t\r\n\r\n\r\n\r\n\r\n/* qa */\r\n.qa-section{background-color:#f9f9f9;padding:7% 0}\r\n.qa-section .qa-list{text-align:left;width:80%;margin:0 auto;}\r\n.qa-section .qa-list li{padding-left:3em;margin-bottom:3em;}\r\n.qa-section .qa-list li:last-child{margin-bottom:0}\r\n.qa-section .qa-list li .question{color:#333;position:relative;font-size:2em;font-weight:600;}\r\n.qa-section .qa-list li .question:before{content:''Q.'';position:absolute;font-weight:700;left:-1.5em}\r\n.qa-section .qa-list li .answer{color:#666;position: relative;font-size:1.5em;padding-left:1.5em;margin-top:0.8em;line-height:1.8}\r\n.qa-section .qa-list li .answer::before{content:''A.'';position:absolute;font-weight:700;left:0.2em;}\r\n.qa-section .qa-list li .answer span{border-bottom:1px solid #333;color:#333;}\r\n\r\n\r\n/*----------------- etc-common -----------------*/\r\n/**제품 주요성분**/\r\n.section.main_ingredient{padd