{"html":"<div class=\"product_detail\">\n<div align=\"center\" class=\"pdt_detail_img\">\n<img alt=\"제품 상세 공지(탑) - 온라인 가품 유통 주의 안내\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.gcoopm.com/shop/storage/shop_image/Ww8yREXDVplPHT9vZS1WKnZe1DiprZ143KbzqknD.jpg\"/>\n</div>\n<div align=\"center\" class=\"pdt_detail_img\" style=\"padding:10px;\"><br/><br/><br/></div>\n</div>\n<div class=\"pdt_detail_img\">\n<link href=\"https://hangeul.pstatic.net/hangeul_static/css/nanum-myeongjo.css\" rel=\"stylesheet\" type=\"text/css\"/>\n<link href=\"https://cdn.gcoop.me/storage/global_image/web_font/NEXONLv2Gothic.css\" rel=\"stylesheet\" type=\"text/css\"/>\n<style type=\"text/css\">/* 기본 */\r\n            .font_NMr {font-family:'NanumMyeongjo' !important;}\r\n            .font_NMb {font-family:'NanumMyeongjoBold' !important;}\r\n            .font_NMeb {font-family:'NanumMyeongjoExtraBold' !important;}\r\n            .Product_DetailWrap * {box-sizing:border-box;word-break:keep-all;word-wrap:break-word;}\r\n            .Product_DetailWrap ul, ol, li, dl, dt, dd, p, div, span, section, i, form, fieldset, input, table, tr, th, td, button, textarea, br {margin:0;padding:0;}\r\n            .Product_DetailWrap i {font-style:normal;}\r\n            .Product_DetailWrap ul, ol, li, dl, dt, dd {list-style:none;}\r\n            .Product_DetailWrap img {width:auto;max-width:100%;margin:0 auto;}\r\n            .Product_DetailWrap {font-family:'NEXON Lv2 Gothic', sans-serif;width:100%;max-width:1200px !important;font-weight:400;margin:0 auto;font-size:12px;text-rendering:optimizeSpeed;letter-spacing:-0.05em;-webkit-letter-spacing:-0.25px;text-align:center;color:#696192;line-height:1.4;padding-bottom:6em;}\r\n\r\n            /* FONT SIZE CSS */\r\n            .Product_DetailWrap p {transform:rotate(0.04deg);}\r\n            .Product_DetailWrap .p0 {font-size:1.1667em;}/*14px*/\r\n            .Product_DetailWrap .p1 {font-size:1.5em;}/*18px*/\r\n            .Product_DetailWrap .p2 {font-size:2em;}/*24px*/\r\n            .Product_DetailWrap .p3 {font-size:2.6667em;}/*32px*/\r\n            .Product_DetailWrap .p4 {font-size:4em;}/*48px*/\r\n            .Product_DetailWrap .p5 {font-size:5em;}/*60px*/\r\n            .Product_DetailWrap .p6 {font-size:8.5em;}/*102px*/\r\n            .Product_DetailWrap .p_sub {font-size:0.6em;vertical-align:baseline;}/*아래첨자*/\r\n            .Product_DetailWrap .p_sup {font-size:0.6em;vertical-align:text-top;}/*위첨자*/\r\n\r\n            /* FONT STYLE CSS */\r\n            .Product_DetailWrap .fw_300 {font-weight:300;}\r\n            .Product_DetailWrap .fw_500 {font-weight:500;}\r\n            .Product_DetailWrap .fw_700 {font-weight:700;}\r\n            .Product_DetailWrap .lh_10 {line-height:1;}\r\n            .Product_DetailWrap .lh_12 {line-height:1.2;}\r\n            .Product_DetailWrap .ta_l {text-align:left;}\r\n            .Product_DetailWrap .ta_r {text-align:right;}\r\n            .Product_DetailWrap .t_up {text-transform:uppercase;}\r\n\r\n            /* FONT COLOR CSS */\r\n            .Product_DetailWrap .color_white {color:#fff;}\r\n            .Product_DetailWrap .color_LavenderGray {color:#a39dc3;}\r\n            .Product_DetailWrap .color_DarkPurple {color:#1c0149;}\r\n            .Product_DetailWrap .color_SapphireBlue {color:#4f3ac1;}\r\n            .Product_DetailWrap .color_Sunflower {color:#f1c40f;}\r\n\r\n            /* BG COLOR CSS */\r\n            .Product_DetailWrap .bg_white {background-color:#fff;}\r\n            .Product_DetailWrap .bg_LavenderWhite {background-color:#f6f5fa;}\r\n            .Product_DetailWrap .bg_SoftLilacWhite {background-color:#faf9fc;}\r\n            .Product_DetailWrap .bg_PastelLavender {background-color:#edeaf5;}\r\n            .Product_DetailWrap .bg_Mercury {background-color:#e5e5e5;}\r\n            .Product_DetailWrap .bg_DarkPurple {background-color:#1c0149;}\r\n            .Product_DetailWrap .bg_SapphireBlue {background-color:#4f3ac1;}\r\n            .Product_DetailWrap .bg_LightGray {background-color:#e7e6e6;}\r\n\r\n            /* MARGIN CSS */\r\n            .Product_DetailWrap .mt_04em {margin-top:0.4em;}\r\n            .Product_DetailWrap .mt_10 {margin-top:10px;}\r\n            .Product_DetailWrap .mt_20 {margin-top:20px;}\r\n            .Product_DetailWrap .mt_30 {margin-top:30px;}\r\n            .Product_DetailWrap .mt_40 {margin-top:40px;}\r\n            .Product_DetailWrap .mt_50 {margin-top:50px;}\r\n            .Product_DetailWrap .mt_60 {margin-top:60px;}\r\n            .Product_DetailWrap .mt_70 {margin-top:70px;}\r\n            .Product_DetailWrap .mt_80 {margin-top:80px;}\r\n            .Product_DetailWrap .mt_90 {margin-top:90px;}\r\n            .Product_DetailWrap .mt_100 {margin-top:100px;}\r\n            .Product_DetailWrap .mt_110 {margin-top:110px;}\r\n            .Product_DetailWrap .mt_120 {margin-top:120px;}\r\n            .Product_DetailWrap .mt_130 {margin-top:130px;}\r\n            .Product_DetailWrap .mt_140 {margin-top:140px;}\r\n            .Product_DetailWrap .mt_150 {margin-top:150px;}\r\n\r\n            /* PADDING CSS */\r\n            .Product_DetailWrap .plr_08 {padding:0 0.8em;}\r\n            .Product_DetailWrap .pd_40 {padding:40px;}\r\n            .Product_DetailWrap .pd_76 {padding:76px;}\r\n            .Product_DetailWrap .pt_20 {padding-top:20px;}\r\n            .Product_DetailWrap .pt_30 {padding-top:30px;}\r\n            .Product_DetailWrap .pt_40 {padding-top:40px;}\r\n            .Product_DetailWrap .pt_50 {padding-top:50px;}\r\n            .Product_DetailWrap .pt_60 {padding-top:60px;}\r\n            .Product_DetailWrap .pt_70 {padding-top:70px;}\r\n            .Product_DetailWrap .pt_80 {padding-top:80px;}\r\n            .Product_DetailWrap .pt_90 {padding-top:90px;}\r\n            .Product_DetailWrap .pt_100 {padding-top:100px;}\r\n            .Product_DetailWrap .pt_110 {padding-top:110px;}\r\n            .Product_DetailWrap .pt_120 {padding-top:120px;}\r\n            .Product_DetailWrap .pt_130 {padding-top:130px;}\r\n            .Product_DetailWrap .pt_140 {padding-top:140px;}\r\n            .Product_DetailWrap .pt_150 {padding-top:150px;}\r\n            .Product_DetailWrap .pb_20 {padding-bottom:20px;}\r\n            .Product_DetailWrap .pb_30 {padding-bottom:30px;}\r\n            .Product_DetailWrap .pb_40 {padding-bottom:40px;}\r\n            .Product_DetailWrap .pb_50 {padding-bottom:50px;}\r\n            .Product_DetailWrap .pb_60 {padding-bottom:60px;}\r\n            .Product_DetailWrap .pb_70 {padding-bottom:70px;}\r\n            .Product_DetailWrap .pb_80 {padding-bottom:80px;}\r\n            .Product_DetailWrap .pb_90 {padding-bottom:90px;}\r\n            .Product_DetailWrap .pb_100 {padding-bottom:100px;}\r\n            .Product_DetailWrap .pb_110 {padding-bottom:110px;}\r\n            .Product_DetailWrap .pb_120 {padding-bottom:120px;}\r\n            .Product_DetailWrap .pb_130 {padding-bottom:130px;}\r\n            .Product_DetailWrap .pb_140 {padding-bottom:140px;}\r\n            .Product_DetailWrap .pb_150 {padding-bottom:150px;}\r\n            \r\n            /* GRID · FLEX 스타일 */\r\n            /* .grid_demo {display:grid;grid-template-columns:29% 6.5% 29% 6.5% 29%;justify-content:space-between;} */\r\n            .Product_DetailWrap .grid_2step {display:grid;grid-template-columns:repeat(2, 48%);justify-content:space-between;row-gap:1.6em;}\r\n            .Product_DetailWrap .grid_3step {display:grid;grid-template-columns:repeat(3, 32%);justify-content:space-between;}\r\n            .Product_DetailWrap .grid_4step {display:grid;grid-template-columns:repeat(4, 24%);justify-content:space-between;}\r\n            .Product_DetailWrap .grid_textList {display:grid;grid-template-columns:2.4167em auto;justify-content:center;align-items:start;gap:1.25em;}\r\n            .Product_DetailWrap .grid_bulletList {display:grid;grid-template-columns:2.5em auto;justify-content:center;align-items:start;gap:1.25em 1em;}\r\n            .Product_DetailWrap .flex_c {display:flex;align-items:center;}\r\n            .Product_DetailWrap .flex_auto {flex:auto;align-self:center;}\r\n            .Product_DetailWrap .flex_c_auto {display:flex;justify-content:center;align-items:center;}\r\n\r\n            /* TABLE STYLE */\r\n            .Product_DetailWrap table{width:100%;padding:0;border:0;border-spacing:0px;border-collapse:collapse;font-size:unset;}\r\n            .Product_DetailWrap .Table_Style1 th {background-color:#f3f3f3;border:1px solid #ccc;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #ccc;color:#121212;font-weight:600;}\r\n            .Product_DetailWrap .Table_Style1 td {border:1px solid #ccc;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n            .Product_DetailWrap .Table_Style1 tr td:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;color:#724848;}\r\n            .Product_DetailWrap .Table_Style1 tr:last-child td:nth-child(3) {border-bottom:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style1 tr th:nth-child(3) {border-left:2px solid #fd6d6d;border-right:2px solid #fd6d6d;border-top:2px solid #fd6d6d;}\r\n            .Product_DetailWrap .Table_Style2 th {background-color:#f9f2f2;border:1px solid #e0d0c3;vertical-align:middle;padding:1.9em 0 1.7em;border-bottom:1px solid #e1e1e1;color:#724848;}\r\n            .Product_DetailWrap .Table_Style2 td {border:1px solid #e0d0c3;padding:1.7em 0 1.5em;vertical-align:middle;}\r\n\r\n            /* 기타 스타일 */\r\n            .Product_DetailWrap .w80 {width:80%;margin-left:10%;}\r\n            .Product_DetailWrap .w90 {width:90%;margin-left:5%;}\r\n            .Product_DetailWrap .h100 {height:100%;}\r\n            .Product_DetailWrap .mgAuto {margin-left:auto;margin-right:auto;}\r\n            .Product_DetailWrap .pos_r {position:relative;}\r\n            .Product_DetailWrap .pos_a {position:absolute;}\r\n            .Product_DetailWrap .wMax {width:max-content;}\r\n            .Product_DetailWrap .wFit {width:fit-content;}\r\n            .Product_DetailWrap .opac80 {opacity:0.8;}\r\n            .Product_DetailWrap .bdr_10 {border-radius:0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_20 {border-radius:1.6667em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_10v {border-radius:0.8333em;}\r\n            .Product_DetailWrap .bdr_l_10 {border-radius:0.8333em 0 0 0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_r_10 {border-radius:0 0.8333em 0.8333em 0;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_t_10 {border-radius:0.8333em 0.8333em 0 0;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_t_20 {border-radius:1.6667em 1.6667em 0 0;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_b_10 {border-radius:0 0 0.8333em 0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .bdr_Line {border:1px solid #d9d9d9;border-radius:0.8333em;overflow:hidden;}\r\n            .Product_DetailWrap .Round_Bar {display:inline-block;width:50%;border-radius:200px;padding:0.8em 1.5em 0.7em;}\r\n            .Product_DetailWrap .Round_Title {display:inline-block;border-radius:200px;padding:1.5em 3.5em 1.4em;}\r\n            .Product_DetailWrap .Round_TitleBar {display:inline-block;position:absolute;border-radius:200px;padding:0.6em 1.5em 0.5em;top:0;left:50%;transform:translate(-50%, -50%);}\r\n            .Product_DetailWrap .SpanBox {padding:0.1em 0.15em 0.05em;}\r\n            .Product_DetailWrap .Box_Shadow {-webkit-box-shadow:0 0 1.25em 0.5em rgba(0,0,0,0.04); box-shadow:0 0 1.25em 0.5em rgba(0,0,0,0.04);}\r\n            .Product_DetailWrap .Text_Underline {text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:0.25em;}\r\n            .Quotationmarks img {width:5.25vw;max-width:63px;}\r\n            .Product_DetailWrap .ybr {display:none;}\r\n            .Product_DetailWrap .nbr {display:block;}\r\n\r\n            /* 브랜드 이미지 */\r\n            .BrandImg .Top_TextBox {position:absolute;top:31%;}\r\n            .BrandImg .Bottom_TextBox {position:absolute;bottom:10%;}\r\n\r\n            .Core_Mechanism {display:grid;grid-template-columns:24% 1.3333% 24% 1.3333% 24% 1.3333% 24%;justify-content:space-between;align-items:start;}\r\n            .Human_Application_Grid li {display:grid;grid-template-columns:40% 1fr;justify-content:space-between;align-items:center;column-gap:5em;}\r\n            .Cell_Management_Grid {display:grid;grid-template-columns:37.1336% 1fr 37.1336%;justify-content:space-between;align-items:center;}\r\n\r\n            /* 키이미지 */\r\n            .KeyImg .Top_TextBox {position:absolute;top:4.4379%;}\r\n            .KeyImg .Bottom_TextBox {position:absolute;bottom:6%;width:80%;left:10%;}\r\n            .KeyImg .keyimg_grid {display:grid;grid-template-columns:11em auto;justify-content:center;align-items:start;column-gap:1em;}\r\n            .KeyImg .keyimg_grid .line {width:calc(100% + 2em);transform:translateX(-1em);padding-top:3em;margin-bottom:3em;grid-column: auto / span 2;border-bottom:1px dotted #696192;line-height:0;}\r\n\r\n            /* 세포의 빗장을 여는 '엑소좀'의 마법 */\r\n            .GB_Exosome {width:80%;left:10%;}\r\n            .GB_Exosome > div > div {position:absolute;width:100%;}\r\n            .GB_Exosome > div > div:nth-child(1) {top:12.5%;height:12.5%;}\r\n            .GB_Exosome > div > div:nth-child(2) {bottom:12%;}\r\n            .GB_Exosome > div > div:nth-child(3) {bottom:-4em;}\r\n\r\n            /* 미세 입자 공법으로  번들거림 없이 피부 속광을 풍부하게 */\r\n            .Product_Comparison p {position:absolute;bottom:10%;width:100%;}\r\n            .Product_Comparison_arrow {margin-left:1em;width:3.5vw;max-width:42px;}\r\n            .Product_Comparison_th {width:8vw;max-width:96px;}\r\n\r\n            /* 메이크업 위에도 부담 없이 사용 가능한 초미세 바이오 미스트 */\r\n            .Before_After_arrow {position:absolute;top:50%;left:50%;width:8vw;max-width:96px;transform:translate(-50%, -100%);}\r\n\r\n            /* 세포 노화 메커니즘 차단 및 생기 충전 */\r\n            .Cellular_Aging {display:grid;grid-template-columns:52% 44%;justify-content:end;align-items:center;}\r\n            .Cellular_Aging_Grid li {display:grid;grid-template-columns:30.4487% 1fr 15.0641%;justify-content:space-between;align-items:center;}\r\n\r\n            /* Reverse Aging Routine */\r\n            .Reverse_Aging:after {content: '';position:absolute;display:block;width:100%;height:1px;border-top:1px solid #edeaf5;top: 50%;left:0;z-index:1;}\r\n            .Reverse_Aging li {z-index:2;}\r\n\r\n            /* 임상 및 인증 */\r\n            .Skin_Test > div {width:80%;margin-left:10%;position:absolute;}\r\n            .Skin_Test > div:nth-child(2) {bottom:5%;height:13.4694%;}\r\n\r\n            .AntiAging_Routine > div {width:85%;margin-left:7.5%;position:absolute;}\r\n            .AntiAging_Routine > div:nth-child(2) {top:40%;height:25%;}\r\n\r\n            .Improvement_Effect {display:grid;grid-template-columns:repeat(2, 25%);justify-content:space-between;}\r\n            .Improvement_Effect div {border-radius:100%;}\r\n\r\n            /* HOW TO USE */\r\n            .HowtoUse_Grid li {display:grid;grid-template-columns:32% 1fr;justify-content:space-between;align-items:center;}\r\n\r\n            .Tip_Grid {display:grid;grid-template-columns:4.5em 1fr;justify-content:space-between;align-items:center;column-gap:1.5em;}\r\n\r\n            /* 브랜드 스토리 */\r\n            .Brand_Grid {display:grid;grid-template-columns:40% 58%;justify-content:space-between;align-items:start;border:#ccc solid 1px;text-align:left;}\r\n            .Brand_Grid .logo_img {max-width:25% !important;margin-top:1em;}\r\n\r\n            @media all and (max-width:1200px) {\r\n                .Product_DetailWrap {padding-bottom:6vw;letter-spacing:-0.05vw;}\r\n                .Product_DetailWrap .mt_10 {margin-top:0.8333vw;}\r\n                .Product_DetailWrap .mt_20 {margin-top:1.6667vw;}\r\n                .Product_DetailWrap .mt_30 {margin-top:2.5vw;}\r\n                .Product_Detai